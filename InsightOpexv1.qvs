///$tab Step 1
SET ThousandSep=',';
SET DecimalSep='.';
SET MoneyThousandSep=',';
SET MoneyDecimalSep='.';
SET MoneyFormat='$ ###0.00;-$ ###0.00';
SET TimeFormat='h:mm:ss TT';
SET DateFormat='M/D/YYYY';
SET TimestampFormat='M/D/YYYY h:mm:ss[.fff] TT';
SET FirstWeekDay=0;
SET BrokenWeeks=1;
SET ReferenceDay=0;
SET FirstMonthOfYear=1;
SET CollationLocale='en-US';
SET CreateSearchIndexOnReload=1;
SET MonthNames='Jan;Feb;Mar;Apr;May;Jun;Jul;Aug;Sep;Oct;Nov;Dec';
SET LongMonthNames='January;February;March;April;May;June;July;August;September;October;November;December';
SET DayNames='Mon;Tue;Wed;Thu;Fri;Sat;Sun';
SET LongDayNames='Monday;Tuesday;Wednesday;Thursday;Friday;Saturday;Sunday';
SET NumericalAbbreviation='3:k;6:M;9:G;12:T;15:P;18:E;21:Z;24:Y;-3:m;-6:μ;-9:n;-12:p;-15:f;-18:a;-21:z;-24:y';



SET vWeekStartDay  = 0;  // 0 = Monday

LET vCurrentWeekStart = Num(WeekStart(Today(),   0, $(vWeekStartDay)));
LET vLastWeekStart    = Num(WeekStart(Today(),  -1, $(vWeekStartDay)));
LET v2WeekStart       = Num(WeekStart(Today(),  -1, $(vWeekStartDay)));
LET v4WeekStart       = Num(WeekStart(Today(),  -4, $(vWeekStartDay)));
LET v13WeekStart      = Num(WeekStart(Today(), -13, $(vWeekStartDay)));
LET v2YearStart = Num(MonthStart(AddMonths(Today(), -24)));
LET v6MonthStart = Num(MonthStart(AddMonths(Today(), -6)));

// Bucket label for order-size-aware Scrap BSP. Call as: $(vScrapBucket(TotalSheets))
SET vScrapBucket = If($1 < 5000,'XLow', If($1 < 10000,'VLow', If($1 < 25000,'Low',
    If($1 < 50000,'LowMid', If($1 < 100000,'Mid', If($1 < 250000,'MidHigh',
    If($1 < 500000,'High', If($1 < 1000000,'VHigh', If($1 < 2500000,'XHigh','Mega')))))))));

SET vBSP_L1_Min        = 15;
SET vBSP_L2_Min        = 25;
SET vBSP_L3_Min        = 35;
SET vMinCoverage       = 0.5;

SET vInsightQVDPath = 'lib://Shared Connections:Office_365_Sharepoint - Reporting - User Defined Credentials/BSS_AMC_MFG/Master Data/Control Room/Qlikcloud Lookups/OPEXinsights/InsightRecord.qvd';
SET vFactQVD        = 'lib://Data - PP:DataFiles/Models/Asset Utilization/model Asset Utilization - Facts.qvd';
SET vSummaryQVDPath = 'lib://Shared Connections:Office_365_Sharepoint - Reporting - User Defined Credentials/BSS_AMC_MFG/Master Data/Control Room/Qlikcloud Lookups/OPEXinsights/MachineWeekSummary.qvd';
SET vSummaryCSVPath = 'lib://Shared Connections:Office_365_Sharepoint - Reporting - User Defined Credentials/BSS_AMC_MFG/Master Data/Control Room/Qlikcloud Lookups/OPEXinsights/MachineWeekSummary.csv';




///$tab Step 2
// ===========================================================
// SECTION 2: PLANT INFORMATION
// ===========================================================

PlantInformation:
NoConcatenate
LOAD
    Plant,
    If("Plant Name" = 'Elk Grove Carton', 'Elk Grove', "Plant Name")    as "Plant Name",
    "Division Name"
FROM [lib://Data - PP:DataFiles/Models/Asset Utilization/model Asset Utilization - PlantInformation.qvd]
(qvd);


// ============================================================
// SECTION 3: WORK CENTER ATTRIBUTES + DEPARTMENT RESOLUTION
// Plant field excluded — Plant reaches PlantInformation
// through fact tables only, preventing circular reference
// ============================================================

WcAttributes:
NoConcatenate
LOAD
    "WC Object ID",
    "WC Description",
    "Work Center",
    "Hierarchy",
    "Class",
    Format,
    Manufacturer,
    "Asset Class",
    "Press Format",
    "Press Size",
    "Hierarchy" & '-' & If(Len(Trim(Format)) = 0, 'NA', Format)         as DepartmentKey,
    "Plant - WC" as "Plant-WC"
FROM [lib://Data - PP:DataFiles/Models/Asset Utilization/model Asset Utilization - WcAttributes.qvd]
(qvd);

[Department_Lookup]:
NoConcatenate
LOAD
    DepartmentKey,
    Department
FROM [lib://Shared Connections:Office_365_Sharepoint - Reporting - User Defined Credentials/BSS_AMC_MFG/Master Data/Control Room/OEE Dashboard Lookups/Department_lookup.xlsx]
(ooxml, embedded labels, table is Department);

LEFT JOIN (WcAttributes)
LOAD
    DepartmentKey,
    Department
RESIDENT [Department_Lookup];

DROP TABLE [Department_Lookup];
DROP FIELD DepartmentKey FROM WcAttributes;


// ============================================================
// SECTION 4: MAPPING TABLES FOR FACT ENRICHMENT
// Source dimension tables (PlantMaterial, Materials,
// BoardTypes) are dropped immediately after mapping tables
// are built — they are not needed in the final data model
// as all attributes are resolved via ApplyMap on fact tables
// ============================================================

[PlantMaterial_Temp]:
NoConcatenate
LOAD
    "Plant Material Key"    as PltMatKey,
    Material,
    "Board Type"
FROM [lib://Data - PP:DataFiles/Models/Asset Utilization/model Asset Utilization - PlantMaterial.qvd]
(qvd);

[Materials_Temp]:
NoConcatenate
LOAD
    Material,
    "Material Base UOM",
    "Material Type",
    "Board Caliper",
    "Carton Depth",
    "Board Width",
    "Material Description"
FROM [lib://Data - PP:DataFiles/Models/Asset Utilization/model Asset Utilization - Materials.qvd]
(qvd);

[BoardTypes_Temp]:
NoConcatenate
LOAD
    "Board Type",
    "Board Type Group"
FROM [lib://Data - PP:DataFiles/Models/Asset Utilization/model Asset Utilization - BoardTypes.qvd]
(qvd);

MaterialConversions:
NoConcatenate
LOAD
    Material,
    Numerator,
    Denominator,
    "Output UOM"
FROM [lib://Data - PP:DataFiles/Models/Asset Utilization/model Asset Utilization - MaterialConversions.qvd]
(qvd);

Plant_Map:
MAPPING LOAD
    "WC Object ID",
    Plant
FROM [lib://Data - PP:DataFiles/Models/Asset Utilization/model Asset Utilization - WcAttributes.qvd]
(qvd);

Department_Map:
MAPPING LOAD
    "WC Object ID",
    Department
RESIDENT WcAttributes;

// Built here while Department still exists in WcAttributes (before DROP FIELD below).
// Used in Step 5 Sections 40–41 for reason L2_ExtraDim derivation. Dropped at end of Section 41.
Department_Rsn_Map:
MAPPING LOAD
    "WC Object ID",
    Department
RESIDENT WcAttributes;

DROP FIELD Department FROM WcAttributes;

BoardType_Map:
MAPPING LOAD
    PltMatKey,
    "Board Type"
RESIDENT [PlantMaterial_Temp];

Material_Map:
MAPPING LOAD
    PltMatKey,
    Material
RESIDENT [PlantMaterial_Temp];

BoardTypeGroup_Map:
MAPPING LOAD
    "Board Type",
    "Board Type Group"
RESIDENT [BoardTypes_Temp];

BoardCaliper_Map:
MAPPING LOAD
    Material,
    "Board Caliper"
RESIDENT [Materials_Temp];

MaterialDesc_Map:
MAPPING LOAD
    Material,
    "Material Description"
RESIDENT [Materials_Temp];

DROP TABLE [PlantMaterial_Temp];
DROP TABLE [Materials_Temp];
DROP TABLE [BoardTypes_Temp];


// ============================================================
// SECTION 5: REASON CODE DIMENSIONS
// ============================================================

TimeReasonCodes:
NoConcatenate
LOAD
    "Time Plant Reason Key"     as tPltRsnKey,
    "Time Reason",
    "Time Category"
FROM [lib://Data - PP:DataFiles/Models/Asset Utilization/model Asset Utilization - TimeReasonCodes.qvd]
(qvd);

// Mapping tables for resolving reason keys to human-readable names in Step 6
// Dropped at end of Section 47 after InsightRecords is built.
TimeReason_Name_Map:
MAPPING LOAD
    "Time Plant Reason Key",
    "Time Reason"
FROM [lib://Data - PP:DataFiles/Models/Asset Utilization/model Asset Utilization - TimeReasonCodes.qvd]
(qvd);

// ============================================================
// SECTION 6: SUPPLEMENTARY DIMENSION — CARTON CATEGORY
// ============================================================

CartonExtraDim:
NoConcatenate
LOAD
    "Carton Style",
    Category
FROM [lib://Shared Connections:Office_365_Sharepoint - Reporting - User Defined Credentials/BSS_AMC_MFG/Master Data/Control Room/OEE Dashboard Lookups/OEE_Dashboard_lookups.xlsx]
(ooxml, embedded labels, table is carton_style_lookup);


// ============================================================
// SECTION 7: ORDER OPERATION — NUMBER UP MAPPING
// Feeds L2 BSP grain for Sheetfed Cutting / Web Cutting depts
// ============================================================

OrderOp_NumberUp_Map:
MAPPING LOAD
    "Order Operation Key",
    "Number Up"
FROM [lib://Data - PP:DataFiles/Models/Asset Utilization/model Asset Utilization - OrderOpData.qvd]
(qvd)
WHERE Not IsNull("Order Operation Key");


// ============================================================
// SECTION 7B: PLANT MANAGER EMAIL MAPPING
// PlantManagers.xlsx columns: Plant, Manager_Name, Manager_Email, CC_List
// Used in Section 49 to stamp Manager_Email onto each summary row
// so the Python notifier can group by Manager_Email with no second config
// ============================================================

PlantManager_Map:
MAPPING LOAD
    Text(Num(Plant, '0000')),
    Manager_Email
FROM [lib://Shared Connections:Office_365_Sharepoint - Reporting - User Defined Credentials/BSS_AMC_MFG/Master Data/Control Room/Qlikcloud Lookups/OPEXinsights/PlantManagers.xlsx]
(ooxml, embedded labels, table is PlantManagers);

PlantManager_CC_Map:
MAPPING LOAD
    Text(Num(Plant, '0000')),
    CC_List
FROM [lib://Shared Connections:Office_365_Sharepoint - Reporting - User Defined Credentials/BSS_AMC_MFG/Master Data/Control Room/Qlikcloud Lookups/OPEXinsights/PlantManagers.xlsx]
(ooxml, embedded labels, table is PlantManagers);


///$tab Step 3
// ============================================================
// SECTION 8: FACT TABLE — PASS 1 — RAW OPTIMIZED QVD LOAD
// No WHERE, no transforms, no aliases — full binary read
// All downstream passes derive from this resident table
// ============================================================

JobFact_Raw:
NoConcatenate
LOAD
    Date,
    "WC Object ID",
    Die,
    "Plant Material Key",
    "Shift Code",
    "Operator ID",
    "Order",
    "Factory Order",
    "Order Operation Key",
    ApplyMap('OrderOp_NumberUp_Map', "Order Operation Key", Null())                            as NumberUp,
    "Carton Style",
    fSched,
    "Time Plant Reason Key",
    "Scrap Plant Reason Key",
    "Max Gluer Cartons Per Hour",
    "OEM Speed",
    "Time - Run",
    "Time - Down",
    "Time - Setup",
    "Time - Setup Down",
    "Time - Non-Crewed",
    "Setup Count",
    "Down Count",
    "Yield in OEE UOM",
    "Scrap in OEE UOM",
    "Yield in BUOM",
    "Scrap in BUOM"
FROM [$(vFactQVD)]
(qvd)
where Date >= '1/1/2025'
    AND Match("WC Object ID",
        10005999, 10003311, 10003313, 10003312, 10003314,
        10002336, 10002335, 10002334, 10002333, 10002332,
        10006627, 10003975, 10004076);


// ============================================================
// SECTION 9: PASS 2A — JOB GRAIN AGGREGATION FOR BSP
// Window  : v2YearStart to last completed week
// MROClass derived inline — numeric 1/2/3 allows Max()
// to correctly return most complex class across all event
// rows for a job, ignoring Nulls on non-MRO rows
// Carton Style kept as dimension for front-end context
// ============================================================

JobFact_Job_BSP_Agg:
NoConcatenate
LOAD
    Date,
    "WC Object ID",
    Die,
    "Shift Code",
    Max(If(WildMatch("Time Plant Reason Key", '*1MR0*'), 1,
        If(WildMatch("Time Plant Reason Key", '*2MR0*'), 2,
            If(WildMatch("Time Plant Reason Key", '*3MR0*'), 3,
                Null()))))                                                                      as MROClass,
    Max(If(fSched = 1, "Max Gluer Cartons Per Hour", Null()))          as MaxGluerCPH,
    Max(If(fSched = 1, "OEM Speed",                  Null()))          as OEMSpeed,
    Sum(If(fSched = 1, "Time - Run",        0))                        as RunHours,
    Sum(If(fSched = 1, "Time - Down",       0))                        as DownHours,
    Sum(If(fSched = 1, "Time - Setup",      0))                        as SetupHours,
    Sum(If(fSched = 1, "Time - Setup Down", 0))                        as SetupDownHours,
    Sum(If(fSched = 1, "Time - Non-Crewed", 0))                        as NonCrewedHours,
    Sum(If(fSched = 1, "Setup Count",       0))                        as SetupCount,
    Sum(If(fSched = 1, "Down Count",        0))                        as DownCount,
    Sum(If(If(IsNull(fSched), 2, fSched) >= 1, "Yield in OEE UOM",  0))                        as GoodQty_OEE,
    Sum(If(If(IsNull(fSched), 2, fSched) >= 1, "Scrap in OEE UOM",  0))                        as ScrapQty_OEE,
    Sum(If(If(IsNull(fSched), 2, fSched) >= 1, "Yield in BUOM",     0))                        as GoodQty_BUOM,
    Sum(If(If(IsNull(fSched), 2, fSched) >= 1, "Scrap in BUOM",     0))                        as ScrapQty_BUOM,
    Sum(If(WildMatch("Time Plant Reason Key", '*PQBW*')
        AND fSched = 1, "Time - Down", 0))                             as BlanketWashHours,
    Sum(If(WildMatch("Time Plant Reason Key", '*PQBW*')
        AND fSched = 1, "Down Count",  0))                             as BlanketWashEvents,
    Sum(If(WildMatch("Time Plant Reason Key", '*PLG5*', '*PLDF*', '*PLF*')
        AND fSched = 1, "Time - Down", 0))                             as FeederTripHours,
    Sum(If(WildMatch("Time Plant Reason Key", '*PLG5*', '*PLDF*', '*PLF*')
        AND fSched = 1, "Down Count",  0))                             as FeederTripEvents
RESIDENT JobFact_Raw
WHERE Date >= $(v2YearStart) AND Date < $(vCurrentWeekStart)
GROUP BY
    Date,
    "WC Object ID",
    Die,
    "Shift Code";


// ============================================================
// SECTION 10: PASS 2B — BSP JOB ENRICHMENT
// Applies board attributes and all derived KPI fields
// Filters to qualifying runs only: RunHours > 2
// ============================================================

JobFact_Job_BSP:
NoConcatenate
LOAD
    Date,
    "WC Object ID",
    Die,
    "Shift Code",
    MROClass,
    RunHours,
    DownHours,
    SetupHours,
    SetupDownHours,
    NonCrewedHours,
    SetupCount,
    DownCount,
    GoodQty_OEE,
    ScrapQty_OEE,
    GoodQty_BUOM,
    ScrapQty_BUOM,
    GoodQty_OEE + ScrapQty_OEE                                                                 as TotalQty_OEE,
    RunHours + DownHours + SetupHours + SetupDownHours + NonCrewedHours                         as SchedHours,
    ApplyMap('Plant_Map',      "WC Object ID", 'Unknown')                                       as Plant,
    ApplyMap('Department_Map', "WC Object ID", 'Unknown')                                       as Department,
    If(ApplyMap('Department_Map', "WC Object ID", '') = 'Gluer'
        OR ApplyMap('Department_Map', "WC Object ID", '') = 'Window',
        MaxGluerCPH, OEMSpeed)                                                                  as MaxSpeed,
    (RunHours + DownHours + SetupHours + SetupDownHours + NonCrewedHours) *
        If(ApplyMap('Department_Map', "WC Object ID", '') = 'Gluer'
            OR ApplyMap('Department_Map', "WC Object ID", '') = 'Window',
            MaxGluerCPH, OEMSpeed)                                                              as OEE_Denom,
    RunHours *
        If(ApplyMap('Department_Map', "WC Object ID", '') = 'Gluer'
            OR ApplyMap('Department_Map', "WC Object ID", '') = 'Window',
            MaxGluerCPH, OEMSpeed)                                                              as Perf_Denom,
    BlanketWashHours,
    BlanketWashEvents,
    FeederTripHours,
    FeederTripEvents
RESIDENT JobFact_Job_BSP_Agg
WHERE RunHours > 2;

///// Remove below part Later 

DROP TABLE JobFact_Job_BSP_Agg;


// ============================================================
// SECTION 11: QUALIFYING RUNS MAPPING TABLES
// Used to filter reason aggregations to qualifying runs only
// and to join job-level denominators to reason grain
// ============================================================

QualifyingRuns_Map:
MAPPING LOAD
    Date & '|' & [WC Object ID] & '|' & [Shift Code] & '|' & Die,
    1
RESIDENT JobFact_Job_BSP;

SchedHours_Map:
MAPPING LOAD
    Date & '|' & [WC Object ID] & '|' & [Shift Code] & '|' & Die,
    SchedHours
RESIDENT JobFact_Job_BSP;

TotalQty_Map:
MAPPING LOAD
    Date & '|' & [WC Object ID] & '|' & [Shift Code] & '|' & Die,
    TotalQty_OEE
RESIDENT JobFact_Job_BSP;


// ============================================================
// SECTION 11B: L2 BSP SOURCE — Date + WC + Shift + Die + PltMatKey
// PltMatKey is a true GROUP BY dimension here — each distinct
// material within a qualifying shift+die is its own data point,
// enabling correct Board Type Group + Board Caliper resolution.
// Filtered to qualifying Die-level runs via QualifyingRuns_Map
// (RunHours > 2 already enforced at the Die grain by that map).
// ============================================================

JobFact_Job_BSP_L2_Agg:
NoConcatenate
LOAD
    Date,
    "WC Object ID",
    Die,
    "Shift Code",
    "Plant Material Key"                                                                        as PltMatKey,
    Only("Carton Style")                                                                        as CartonStyle,
    Max(NumberUp)                                                                               as NumberUp,
    Max(If(WildMatch("Time Plant Reason Key", '*1MR0*'), 1,
        If(WildMatch("Time Plant Reason Key", '*2MR0*'), 2,
            If(WildMatch("Time Plant Reason Key", '*3MR0*'), 3,
                Null()))))                                                                      as MROClass,
    Max(If(fSched = 1, "Max Gluer Cartons Per Hour", Null()))          as MaxGluerCPH,
    Max(If(fSched = 1, "OEM Speed",                  Null()))          as OEMSpeed,
    Sum(If(fSched = 1, "Time - Run",        0))                        as RunHours,
    Sum(If(fSched = 1, "Time - Down",       0))                        as DownHours,
    Sum(If(fSched = 1, "Time - Setup",      0))                        as SetupHours,
    Sum(If(fSched = 1, "Time - Setup Down", 0))                        as SetupDownHours,
    Sum(If(fSched = 1, "Time - Non-Crewed", 0))                        as NonCrewedHours,
    Sum(If(fSched = 1, "Setup Count",       0))                        as SetupCount,
    Sum(If(If(IsNull(fSched), 2, fSched) >= 1, "Yield in OEE UOM",  0))                        as GoodQty_OEE,
    Sum(If(If(IsNull(fSched), 2, fSched) >= 1, "Scrap in OEE UOM",  0))                        as ScrapQty_OEE,
    Sum(If(WildMatch("Time Plant Reason Key", '*PQBW*')
        AND fSched = 1, "Time - Down", 0))                             as BlanketWashHours,
    Sum(If(WildMatch("Time Plant Reason Key", '*PQBW*')
        AND fSched = 1, "Down Count",  0))                             as BlanketWashEvents,
    Sum(If(WildMatch("Time Plant Reason Key", '*PLG5*', '*PLDF*', '*PLF*')
        AND fSched = 1, "Time - Down", 0))                             as FeederTripHours,
    Sum(If(WildMatch("Time Plant Reason Key", '*PLG5*', '*PLDF*', '*PLF*')
        AND fSched = 1, "Down Count",  0))                             as FeederTripEvents
RESIDENT JobFact_Raw
WHERE
    Date >= $(v2YearStart) AND Date < $(vCurrentWeekStart)
    AND ApplyMap('QualifyingRuns_Map',
            Date & '|' & [WC Object ID] & '|' & [Shift Code] & '|' & Die, 0) = 1
GROUP BY
    Date,
    "WC Object ID",
    Die,
    "Shift Code",
    "Plant Material Key";

JobFact_Job_BSP_L2:
NoConcatenate
LOAD
    "WC Object ID",
    Die,
    MROClass,
    CartonStyle,
    NumberUp,
    RunHours,
    DownHours,
    SetupHours,
    SetupDownHours,
    SetupCount,
    GoodQty_OEE,
    ScrapQty_OEE,
    GoodQty_OEE + ScrapQty_OEE                                                                 as TotalQty_OEE,
    RunHours + DownHours + SetupHours + SetupDownHours + NonCrewedHours                         as SchedHours,
    ApplyMap('Plant_Map',      "WC Object ID", 'Unknown')                                       as Plant,
    ApplyMap('Department_Map', "WC Object ID", 'Unknown')                                       as Department,
    If(Match(ApplyMap('Department_Map', "WC Object ID", 'Unknown'), 'Gluer', 'Window'),
            Text(CartonStyle),
        If(Match(ApplyMap('Department_Map', "WC Object ID", 'Unknown'), 'Sheetfed Cutting', 'Web Cutting'),
            Text(NumberUp),
           ''))                                                                                 as L2_ExtraDim,
    (RunHours + DownHours + SetupHours + SetupDownHours + NonCrewedHours) *
        If(ApplyMap('Department_Map', "WC Object ID", '') = 'Gluer'
            OR ApplyMap('Department_Map', "WC Object ID", '') = 'Window',
            MaxGluerCPH, OEMSpeed)                                                              as OEE_Denom,
    RunHours *
        If(ApplyMap('Department_Map', "WC Object ID", '') = 'Gluer'
            OR ApplyMap('Department_Map', "WC Object ID", '') = 'Window',
            MaxGluerCPH, OEMSpeed)                                                              as Perf_Denom,
    ApplyMap('BoardTypeGroup_Map', ApplyMap('BoardType_Map', PltMatKey, Null()),   Null())       as "Board Type Group",
    ApplyMap('BoardCaliper_Map',   ApplyMap('Material_Map',  PltMatKey, Null()),   Null())       as "Board Caliper",
    ApplyMap('MaterialDesc_Map',   ApplyMap('Material_Map',  PltMatKey, Null()),   Null())       as MaterialDescription,
    BlanketWashHours,
    BlanketWashEvents,
    FeederTripHours,
    FeederTripEvents
RESIDENT JobFact_Job_BSP_L2_Agg;

DROP TABLE JobFact_Job_BSP_L2_Agg;


// ============================================================
// SECTION 12: PASS 3A — DOWNTIME REASON GRAIN AGGREGATION
// Window  : v2YearStart to last completed week
// Filter  : Qualifying runs only via QualifyingRuns_Map
//           MRO reason rows excluded — setup not downtime
//           Rows with null Time Plant Reason Key excluded
// ============================================================

JobFact_DownReason_BSP_Agg:
NoConcatenate
LOAD
    Date,
    "WC Object ID",
    Die,
    "Shift Code",
    "Plant Material Key"                                                                        as PltMatKey,
    Only("Carton Style")                                                                        as CartonStyle,
    Max(NumberUp)                                                                               as NumberUp,
    "Time Plant Reason Key",
    Sum(If(fSched = 1, "Time - Down", 0))                              as ReasonDownHours
RESIDENT JobFact_Raw
WHERE
    Date >= $(v2YearStart)
    AND Date < $(vCurrentWeekStart)
    AND Not IsNull("Time Plant Reason Key")
    AND Not WildMatch("Time Plant Reason Key", '*MR0*', '*PQBW*', '*PLG5*', '*PLDF*', '*PLF*')
    AND ApplyMap('QualifyingRuns_Map',
            Date & '|' & [WC Object ID] & '|' & [Shift Code] & '|' & Die, 0) = 1
GROUP BY
    Date,
    "WC Object ID",
    Die,
    "Shift Code",
    "Plant Material Key",
    "Time Plant Reason Key";

JobFact_DownReason_BSP:
NoConcatenate
LOAD
    "WC Object ID",
    Die,
    PltMatKey,
    CartonStyle,
    NumberUp,
    "Time Plant Reason Key",
    ReasonDownHours,
    ApplyMap('SchedHours_Map',
        Date & '|' & [WC Object ID] & '|' & [Shift Code] & '|' & Die, Null())                  as SchedHours,
    ApplyMap('Plant_Map',      "WC Object ID", 'Unknown')                                       as Plant,
    ApplyMap('Department_Map', "WC Object ID", 'Unknown')                                       as Department,
    If(Match(ApplyMap('Department_Map', "WC Object ID", 'Unknown'), 'Gluer', 'Window'),
            Text(CartonStyle),
        If(Match(ApplyMap('Department_Map', "WC Object ID", 'Unknown'), 'Sheetfed Cutting', 'Web Cutting'),
            Text(NumberUp),
           ''))                                                                                 as L2_ExtraDim,
    ApplyMap('BoardTypeGroup_Map', ApplyMap('BoardType_Map', PltMatKey, Null()), Null())         as "Board Type Group",
    ApplyMap('BoardCaliper_Map',   ApplyMap('Material_Map',  PltMatKey, Null()), Null())         as "Board Caliper"
RESIDENT JobFact_DownReason_BSP_Agg;

DROP TABLE JobFact_DownReason_BSP_Agg;


DROP MAPPING TABLE QualifyingRuns_Map;
DROP MAPPING TABLE SchedHours_Map;
DROP MAPPING TABLE TotalQty_Map;


// ============================================================
// SECTION 14: PASS 4A — JOB GRAIN AGGREGATION FOR SCORING
// Window  : 13-week trend + current 2-week scoring window
// No RunHours > 2 filter — all runs included for trend
// MROClass derived inline — same numeric pattern as BSP pass
// ============================================================

JobFact_Scoring_Agg:
NoConcatenate
LOAD
    Date,
    "WC Object ID",
    Die,
    "Carton Style",
    "Plant Material Key"                                                                        as PltMatKey,
    "Shift Code",
    "Operator ID",
    "Order",
    "Factory Order",
    Max(NumberUp)                                                                               as NumberUp,
    Max(If(WildMatch("Time Plant Reason Key", '*1MR0*'), 1,
        If(WildMatch("Time Plant Reason Key", '*2MR0*'), 2,
            If(WildMatch("Time Plant Reason Key", '*3MR0*'), 3,
                Null()))))                                                                      as MROClass,
    Max(If(fSched = 1, "Max Gluer Cartons Per Hour", Null()))          as MaxGluerCPH,
    Max(If(fSched = 1, "OEM Speed",                  Null()))          as OEMSpeed,
    Sum(If(fSched = 1, "Time - Run",        0))                        as RunHours,
    Sum(If(fSched = 1, "Time - Down",       0))                        as DownHours,
    Sum(If(fSched = 1, "Time - Setup",      0))                        as SetupHours,
    Sum(If(fSched = 1, "Time - Setup Down", 0))                        as SetupDownHours,
    Sum(If(fSched = 1, "Time - Non-Crewed", 0))                        as NonCrewedHours,
    Sum(If(fSched = 1, "Setup Count",       0))                        as SetupCount,
    Sum(If(fSched = 1, "Down Count",        0))                        as DownCount,
    Sum(If(If(IsNull(fSched), 2, fSched) >= 1, "Yield in OEE UOM",  0))                        as GoodQty_OEE,
    Sum(If(If(IsNull(fSched), 2, fSched) >= 1, "Scrap in OEE UOM",  0))                        as ScrapQty_OEE,
    Sum(If(If(IsNull(fSched), 2, fSched) >= 1, "Yield in BUOM",     0))                        as GoodQty_BUOM,
    Sum(If(If(IsNull(fSched), 2, fSched) >= 1, "Scrap in BUOM",     0))                        as ScrapQty_BUOM,
    Sum(If(WildMatch("Time Plant Reason Key", '*PQBW*')
        AND fSched = 1, "Time - Down", 0))                             as BlanketWashHours,
    Sum(If(WildMatch("Time Plant Reason Key", '*PQBW*')
        AND fSched = 1, "Down Count",  0))                             as BlanketWashEvents,
    Sum(If(WildMatch("Time Plant Reason Key", '*PLG5*', '*PLDF*', '*PLF*')
        AND fSched = 1, "Time - Down", 0))                             as FeederTripHours,
    Sum(If(WildMatch("Time Plant Reason Key", '*PLG5*', '*PLDF*', '*PLF*')
        AND fSched = 1, "Down Count",  0))                             as FeederTripEvents
RESIDENT JobFact_Raw
WHERE Date >= $(v13WeekStart) AND Date < $(vCurrentWeekStart)
GROUP BY
    Date,
    "WC Object ID",
    Die,
    "Carton Style",
    "Plant Material Key",
    "Shift Code",
    "Operator ID",
    "Order",
    "Factory Order";


// ============================================================
// SECTION 15: PASS 4B — SCORING JOB ENRICHMENT
// Applies board attributes and all derived KPI fields
// No RunHours > 2 filter — trend needs all runs
// JobFact_Raw dropped after this final pass
// All remaining mapping tables dropped after this section
// ============================================================

JobFact_Scoring:
NoConcatenate
LOAD
    Date,
    "WC Object ID",
    Die,
    "Carton Style",
    PltMatKey,
    "Shift Code",
    "Operator ID",
    "Order",
    "Factory Order",
    NumberUp,
    MROClass,
    RunHours,
    DownHours,
    SetupHours,
    SetupDownHours,
    NonCrewedHours,
    SetupCount,
    DownCount,
    GoodQty_OEE,
    ScrapQty_OEE,
    GoodQty_BUOM,
    ScrapQty_BUOM,
    GoodQty_OEE + ScrapQty_OEE                                                                 as TotalQty_OEE,
    RunHours + DownHours + SetupHours + SetupDownHours + NonCrewedHours                         as SchedHours,
    ApplyMap('Plant_Map',      "WC Object ID", 'Unknown')                                       as Plant,
    ApplyMap('Department_Map', "WC Object ID", 'Unknown')                                       as Department,
    If(ApplyMap('Department_Map', "WC Object ID", '') = 'Gluer'
        OR ApplyMap('Department_Map', "WC Object ID", '') = 'Window',
        MaxGluerCPH, OEMSpeed)                                                                  as MaxSpeed,
    (RunHours + DownHours + SetupHours + SetupDownHours + NonCrewedHours) *
        If(ApplyMap('Department_Map', "WC Object ID", '') = 'Gluer'
            OR ApplyMap('Department_Map', "WC Object ID", '') = 'Window',
            MaxGluerCPH, OEMSpeed)                                                              as OEE_Denom,
    RunHours *
        If(ApplyMap('Department_Map', "WC Object ID", '') = 'Gluer'
            OR ApplyMap('Department_Map', "WC Object ID", '') = 'Window',
            MaxGluerCPH, OEMSpeed)                                                              as Perf_Denom,
    ApplyMap('BoardType_Map',      PltMatKey,                                     Null())       as "Board Type",
    ApplyMap('BoardTypeGroup_Map', ApplyMap('BoardType_Map', PltMatKey, Null()),   Null())       as "Board Type Group",
    ApplyMap('BoardCaliper_Map',   ApplyMap('Material_Map',  PltMatKey, Null()),   Null())       as "Board Caliper",
    ApplyMap('MaterialDesc_Map',   ApplyMap('Material_Map',  PltMatKey, Null()),   Null())       as MaterialDescription,
    BlanketWashHours,
    BlanketWashEvents,
    FeederTripHours,
    FeederTripEvents
RESIDENT JobFact_Scoring_Agg;

DROP TABLE JobFact_Scoring_Agg;


// ============================================================
// SECTION 15B: ORDER-LEVEL SCRAP BSP SOURCE
// Grain  : WC Object ID + Order
// Window : v6MonthStart to last completed week
// Filter : SetupCount = 1 (single-setup orders only)
// Used in Section 28B (Tab 4) to build BSP_ScrapBucket_Map
// ============================================================

JobFact_Order_Scrap_Agg:
NoConcatenate
LOAD
    "WC Object ID",
    "Order",
    Sum(If(If(IsNull(fSched), 2, fSched) >= 1, "Yield in OEE UOM" + "Scrap in OEE UOM", 0))  as TotalSheets,
    Sum(If(If(IsNull(fSched), 2, fSched) >= 1, "Scrap in OEE UOM", 0))                        as ScrapSheets,
    Sum(If(fSched = 1, "Setup Count", 0))                                                      as SetupCount
RESIDENT JobFact_Raw
WHERE Date >= $(v6MonthStart) AND Date < $(vCurrentWeekStart)
GROUP BY "WC Object ID", "Order";

JobFact_Order_Scrap:
NoConcatenate
LOAD
    ApplyMap('Plant_Map', "WC Object ID", 'Unknown')  as Plant,
    "WC Object ID",
    "Order",
    TotalSheets,
    ScrapSheets,
    ScrapSheets / TotalSheets                         as ScrapPct_Order,
    $(vScrapBucket(TotalSheets))                      as ScrapBucket
RESIDENT JobFact_Order_Scrap_Agg
WHERE SetupCount = 1 AND TotalSheets > 0;

DROP TABLE JobFact_Order_Scrap_Agg;


DROP TABLE JobFact_Raw;
DROP MAPPING TABLE Plant_Map;
DROP MAPPING TABLE Department_Map;
DROP MAPPING TABLE BoardType_Map;
DROP MAPPING TABLE Material_Map;
DROP MAPPING TABLE BoardTypeGroup_Map;
DROP MAPPING TABLE BoardCaliper_Map;
DROP MAPPING TABLE MaterialDesc_Map;
// OrderOp_NumberUp_Map kept alive — still needed for reason die-level
// aggregations in Sections 40–41. Dropped at end of Section 41.
///$tab Step 4
// ============================================================
// SECTION 17: MAIN KPI BSP — LEVEL 1
// Grain  : Plant + WC Object ID + Die
// Min    : 10 qualifying runs
// P90    : OEE, Availability, Performance, Quality, Speed
// P10    : Downtime %, Downtime Hrs, Scrap Loss (bucket-aware — see Section 28B)
// ============================================================

BSP_Main_L1_Raw:
NoConcatenate
LOAD
    Plant,
    "WC Object ID",
    Die,
    Count(1)                                                                                    as L1_RunCount,
    FRACTILE(If(OEE_Denom    > 0, GoodQty_OEE  / OEE_Denom,    Null()), 0.75)                  as L1_BSP_OEE,
    FRACTILE(If(RunHours     > 0, TotalQty_OEE / RunHours,      Null()), 0.75)                  as L1_BSP_Speed,
    FRACTILE(If(SchedHours   > 0, (DownHours + SetupDownHours) / SchedHours, Null()), 0.25)     as L1_BSP_DowntimePct,
    FRACTILE(DownHours + SetupDownHours,                                      0.25)              as L1_BSP_DowntimeHrs,
    FRACTILE(If(TotalQty_OEE > 0, ScrapQty_OEE / TotalQty_OEE, Null()), 0.25)                  as L1_BSP_ScrapRate
RESIDENT JobFact_Job_BSP
GROUP BY Plant, "WC Object ID", Die;

BSP_Main_L1:
NoConcatenate
LOAD * RESIDENT BSP_Main_L1_Raw WHERE L1_RunCount >= $(vBSP_L1_Min);
DROP TABLE BSP_Main_L1_Raw;


// ============================================================
// SECTION 18: MAIN KPI BSP — LEVEL 2
// Grain  : Plant + WC Object ID + Board Type Group + Board Caliper
// Min    : 20 qualifying runs
// Excludes rows with null board attributes
// ============================================================

BSP_Main_L2_Raw:
NoConcatenate
LOAD
    Plant,
    "WC Object ID",
    "Board Type Group",
    "Board Caliper",
    L2_ExtraDim,
    Count(1)                                                                                    as L2_RunCount,
    FRACTILE(If(OEE_Denom    > 0, GoodQty_OEE  / OEE_Denom,    Null()), 0.75)                  as L2_BSP_OEE,
    FRACTILE(If(RunHours     > 0, TotalQty_OEE / RunHours,      Null()), 0.75)                  as L2_BSP_Speed,
    FRACTILE(If(SchedHours   > 0, (DownHours + SetupDownHours) / SchedHours, Null()), 0.25)     as L2_BSP_DowntimePct,
    FRACTILE(DownHours + SetupDownHours,                                      0.25)              as L2_BSP_DowntimeHrs,
    FRACTILE(If(TotalQty_OEE > 0, ScrapQty_OEE / TotalQty_OEE, Null()), 0.25)                  as L2_BSP_ScrapRate
RESIDENT JobFact_Job_BSP_L2
WHERE Not IsNull("Board Type Group") AND Not IsNull("Board Caliper")
GROUP BY Plant, "WC Object ID", "Board Type Group", "Board Caliper", L2_ExtraDim;

BSP_Main_L2:
NoConcatenate
LOAD * RESIDENT BSP_Main_L2_Raw WHERE L2_RunCount >= $(vBSP_L2_Min);
DROP TABLE BSP_Main_L2_Raw;


// ============================================================
// SECTION 19: MAIN KPI BSP — LEVEL 3
// Grain  : Plant + WC Object ID
// Min    : 30 qualifying runs
// ============================================================

BSP_Main_L3_Raw:
NoConcatenate
LOAD
    Plant,
    "WC Object ID",
    Count(1)                                                                                    as L3_RunCount,
    FRACTILE(If(OEE_Denom    > 0, GoodQty_OEE  / OEE_Denom,    Null()), 0.75)                  as L3_BSP_OEE,
    FRACTILE(If(RunHours     > 0, TotalQty_OEE / RunHours,      Null()), 0.75)                  as L3_BSP_Speed,
    FRACTILE(If(SchedHours   > 0, (DownHours + SetupDownHours) / SchedHours, Null()), 0.25)     as L3_BSP_DowntimePct,
    FRACTILE(DownHours + SetupDownHours,                                      0.25)              as L3_BSP_DowntimeHrs,
    FRACTILE(If(TotalQty_OEE > 0, ScrapQty_OEE / TotalQty_OEE, Null()), 0.25)                  as L3_BSP_ScrapRate
RESIDENT JobFact_Job_BSP
GROUP BY Plant, "WC Object ID";

BSP_Main_L3:
NoConcatenate
LOAD * RESIDENT BSP_Main_L3_Raw WHERE L3_RunCount >= $(vBSP_L3_Min);
DROP TABLE BSP_Main_L3_Raw;


// ============================================================
// SECTION 20: SETUP KPI BSP — LEVEL 1
// Grain  : Plant + WC Object ID + Die + MROClass
// Filter : SetupCount > 0 AND MROClass not null
// Min    : 10 qualifying runs
// P10    : Setup Hrs/Changeover, Setup Time %
// ============================================================

BSP_Setup_L1_Raw:
NoConcatenate
LOAD
    Plant,
    "WC Object ID",
    Die,
    MROClass,
    MaterialDescription,
    Count(1)                                                                                    as L1_SetupRunCount,
    FRACTILE(If(SetupCount   > 0, SetupHours / SetupCount,  Null()), 0.25)                      as L1_BSP_SetupHrsPerEvent
RESIDENT JobFact_Job_BSP_L2
WHERE SetupCount > 0 AND Not IsNull(MROClass)
GROUP BY Plant, "WC Object ID", Die, MROClass, MaterialDescription;

BSP_Setup_L1:
NoConcatenate
LOAD * RESIDENT BSP_Setup_L1_Raw WHERE L1_SetupRunCount >= $(vBSP_L1_Min);
DROP TABLE BSP_Setup_L1_Raw;


// ============================================================
// SECTION 21: SETUP KPI BSP — LEVEL 2
// Grain  : Plant + WC Object ID + Board Type Group +
//          Board Caliper + MROClass
// Min    : 20 qualifying runs
// ============================================================

BSP_Setup_L2_Raw:
NoConcatenate
LOAD
    Plant,
    "WC Object ID",
    "Board Type Group",
    "Board Caliper",
    L2_ExtraDim,
    MROClass,
    Count(1)                                                                                    as L2_SetupRunCount,
    FRACTILE(If(SetupCount   > 0, SetupHours / SetupCount,  Null()), 0.25)                      as L2_BSP_SetupHrsPerEvent
RESIDENT JobFact_Job_BSP_L2
WHERE SetupCount > 0
    AND Not IsNull(MROClass)
    AND Not IsNull("Board Type Group")
    AND Not IsNull("Board Caliper")
GROUP BY Plant, "WC Object ID", "Board Type Group", "Board Caliper", L2_ExtraDim, MROClass;

BSP_Setup_L2:
NoConcatenate
LOAD * RESIDENT BSP_Setup_L2_Raw WHERE L2_SetupRunCount >= $(vBSP_L2_Min);
DROP TABLE BSP_Setup_L2_Raw;


// ============================================================
// SECTION 22: SETUP KPI BSP — LEVEL 3
// Grain  : Plant + WC Object ID + MROClass
// Min    : 30 qualifying runs
// ============================================================

BSP_Setup_L3_Raw:
NoConcatenate
LOAD
    Plant,
    "WC Object ID",
    MROClass,
    Count(1)                                                                                    as L3_SetupRunCount,
    FRACTILE(If(SetupCount   > 0, SetupHours / SetupCount,  Null()), 0.25)                      as L3_BSP_SetupHrsPerEvent
RESIDENT JobFact_Job_BSP
WHERE SetupCount > 0 AND Not IsNull(MROClass)
GROUP BY Plant, "WC Object ID", MROClass;

BSP_Setup_L3:
NoConcatenate
LOAD * RESIDENT BSP_Setup_L3_Raw WHERE L3_SetupRunCount >= $(vBSP_L3_Min);
DROP TABLE BSP_Setup_L3_Raw;


// ============================================================
// SECTION 23: DOWNTIME REASON BSP — LEVEL 1
// Grain  : Plant + WC Object ID + Die + Time Plant Reason Key
// Metric : P10 of ReasonDownHours / SchedHours per reason
// Min    : 10 qualifying job runs with this reason
// Field kept as original name — NOT aliased to tPltRsnKey
// to avoid unwanted join to TimeReasonCodes in data model
// ============================================================

BSP_DownReason_L1_Raw:
NoConcatenate
LOAD
    Plant,
    "WC Object ID",
    Die,
    "Time Plant Reason Key",
    Count(1)                                                                                    as L1_DwnRsnCount,
    FRACTILE(If(SchedHours   > 0, ReasonDownHours / SchedHours, Null()), 0.25)                  as L1_BSP_ReasonDownPct
RESIDENT JobFact_DownReason_BSP
GROUP BY Plant, "WC Object ID", Die, "Time Plant Reason Key";

BSP_DownReason_L1:
NoConcatenate
LOAD * RESIDENT BSP_DownReason_L1_Raw WHERE L1_DwnRsnCount >= $(vBSP_L1_Min);
DROP TABLE BSP_DownReason_L1_Raw;


// ============================================================
// SECTION 24: DOWNTIME REASON BSP — LEVEL 2
// Grain  : Plant + WC Object ID + Board Type Group +
//          Board Caliper + Time Plant Reason Key
// Min    : 20 qualifying runs
// ============================================================

BSP_DownReason_L2_Raw:
NoConcatenate
LOAD
    Plant,
    "WC Object ID",
    "Board Type Group",
    "Board Caliper",
    L2_ExtraDim,
    "Time Plant Reason Key",
    Count(1)                                                                                    as L2_DwnRsnCount,
    FRACTILE(If(SchedHours   > 0, ReasonDownHours / SchedHours, Null()), 0.25)                  as L2_BSP_ReasonDownPct
RESIDENT JobFact_DownReason_BSP
WHERE Not IsNull("Board Type Group") AND Not IsNull("Board Caliper")
GROUP BY Plant, "WC Object ID", "Board Type Group", "Board Caliper", L2_ExtraDim, "Time Plant Reason Key";

BSP_DownReason_L2:
NoConcatenate
LOAD * RESIDENT BSP_DownReason_L2_Raw WHERE L2_DwnRsnCount >= $(vBSP_L2_Min);
DROP TABLE BSP_DownReason_L2_Raw;


// ============================================================
// SECTION 25: DOWNTIME REASON BSP — LEVEL 3
// Grain  : Plant + WC Object ID + Time Plant Reason Key
// Min    : 30 qualifying runs
// ============================================================

BSP_DownReason_L3_Raw:
NoConcatenate
LOAD
    Plant,
    "WC Object ID",
    "Time Plant Reason Key",
    Count(1)                                                                                    as L3_DwnRsnCount,
    FRACTILE(If(SchedHours   > 0, ReasonDownHours / SchedHours, Null()), 0.25)                  as L3_BSP_ReasonDownPct
RESIDENT JobFact_DownReason_BSP
GROUP BY Plant, "WC Object ID", "Time Plant Reason Key";

BSP_DownReason_L3:
NoConcatenate
LOAD * RESIDENT BSP_DownReason_L3_Raw WHERE L3_DwnRsnCount >= $(vBSP_L3_Min);
DROP TABLE BSP_DownReason_L3_Raw;

DROP TABLE JobFact_DownReason_BSP;


// ============================================================
// SECTION 29A: AVG BLANKET WASH TIME BSP — ALL 3 LEVELS
// Metric : BlanketWashHours / BlanketWashEvents (hrs per event)
// Direction : lower-is-better (P25)
// Filter  : BlanketWashEvents > 0 (machine had blanket wash events)
// L1 grain : Plant + WC + Die
// L2 grain : Plant + WC + BTG + BC + L2_ExtraDim
// L3 grain : Plant + WC
// ============================================================

BSP_BlanketWashTime_L1_Raw:
NoConcatenate
LOAD
    Plant,
    "WC Object ID",
    Die,
    Count(1)                                                                                      as BWT_L1_Count,
    FRACTILE(If(BlanketWashEvents > 0, BlanketWashHours / BlanketWashEvents, Null()), 0.25)       as L1_BSP_BlanketWashTime
RESIDENT JobFact_Job_BSP
WHERE BlanketWashEvents > 0
GROUP BY Plant, "WC Object ID", Die;

BSP_BlanketWashTime_L1:
NoConcatenate
LOAD * RESIDENT BSP_BlanketWashTime_L1_Raw WHERE BWT_L1_Count >= $(vBSP_L1_Min);
DROP TABLE BSP_BlanketWashTime_L1_Raw;


BSP_BlanketWashTime_L2_Raw:
NoConcatenate
LOAD
    Plant,
    "WC Object ID",
    "Board Type Group",
    "Board Caliper",
    L2_ExtraDim,
    Count(1)                                                                                      as BWT_L2_Count,
    FRACTILE(If(BlanketWashEvents > 0, BlanketWashHours / BlanketWashEvents, Null()), 0.25)       as L2_BSP_BlanketWashTime
RESIDENT JobFact_Job_BSP_L2
WHERE BlanketWashEvents > 0
    AND Not IsNull("Board Type Group") AND Not IsNull("Board Caliper")
GROUP BY Plant, "WC Object ID", "Board Type Group", "Board Caliper", L2_ExtraDim;

BSP_BlanketWashTime_L2:
NoConcatenate
LOAD * RESIDENT BSP_BlanketWashTime_L2_Raw WHERE BWT_L2_Count >= $(vBSP_L2_Min);
DROP TABLE BSP_BlanketWashTime_L2_Raw;


BSP_BlanketWashTime_L3_Raw:
NoConcatenate
LOAD
    Plant,
    "WC Object ID",
    Count(1)                                                                                      as BWT_L3_Count,
    FRACTILE(If(BlanketWashEvents > 0, BlanketWashHours / BlanketWashEvents, Null()), 0.25)       as L3_BSP_BlanketWashTime
RESIDENT JobFact_Job_BSP
WHERE BlanketWashEvents > 0
GROUP BY Plant, "WC Object ID";

BSP_BlanketWashTime_L3:
NoConcatenate
LOAD * RESIDENT BSP_BlanketWashTime_L3_Raw WHERE BWT_L3_Count >= $(vBSP_L3_Min);
DROP TABLE BSP_BlanketWashTime_L3_Raw;


// ============================================================
// SECTION 29B: AVG FEEDER TRIP TIME BSP — ALL 3 LEVELS
// Metric : FeederTripHours / FeederTripEvents (hrs per event)
// Direction : lower-is-better (P25)
// Filter  : FeederTripEvents > 0
// ============================================================

BSP_FeederTripTime_L1_Raw:
NoConcatenate
LOAD
    Plant,
    "WC Object ID",
    Die,
    Count(1)                                                                                      as FTT_L1_Count,
    FRACTILE(If(FeederTripEvents > 0, FeederTripHours / FeederTripEvents, Null()), 0.25)          as L1_BSP_FeederTripTime
RESIDENT JobFact_Job_BSP
WHERE FeederTripEvents > 0
GROUP BY Plant, "WC Object ID", Die;

BSP_FeederTripTime_L1:
NoConcatenate
LOAD * RESIDENT BSP_FeederTripTime_L1_Raw WHERE FTT_L1_Count >= $(vBSP_L1_Min);
DROP TABLE BSP_FeederTripTime_L1_Raw;


BSP_FeederTripTime_L2_Raw:
NoConcatenate
LOAD
    Plant,
    "WC Object ID",
    "Board Type Group",
    "Board Caliper",
    L2_ExtraDim,
    Count(1)                                                                                      as FTT_L2_Count,
    FRACTILE(If(FeederTripEvents > 0, FeederTripHours / FeederTripEvents, Null()), 0.25)          as L2_BSP_FeederTripTime
RESIDENT JobFact_Job_BSP_L2
WHERE FeederTripEvents > 0
    AND Not IsNull("Board Type Group") AND Not IsNull("Board Caliper")
GROUP BY Plant, "WC Object ID", "Board Type Group", "Board Caliper", L2_ExtraDim;

BSP_FeederTripTime_L2:
NoConcatenate
LOAD * RESIDENT BSP_FeederTripTime_L2_Raw WHERE FTT_L2_Count >= $(vBSP_L2_Min);
DROP TABLE BSP_FeederTripTime_L2_Raw;


BSP_FeederTripTime_L3_Raw:
NoConcatenate
LOAD
    Plant,
    "WC Object ID",
    Count(1)                                                                                      as FTT_L3_Count,
    FRACTILE(If(FeederTripEvents > 0, FeederTripHours / FeederTripEvents, Null()), 0.25)          as L3_BSP_FeederTripTime
RESIDENT JobFact_Job_BSP
WHERE FeederTripEvents > 0
GROUP BY Plant, "WC Object ID";

BSP_FeederTripTime_L3:
NoConcatenate
LOAD * RESIDENT BSP_FeederTripTime_L3_Raw WHERE FTT_L3_Count >= $(vBSP_L3_Min);
DROP TABLE BSP_FeederTripTime_L3_Raw;


DROP TABLE JobFact_Job_BSP;
DROP TABLE JobFact_Job_BSP_L2;


// ============================================================
// SECTION 28B: SCRAP BUCKET BSP
// Grain  : Plant + WC Object ID + ScrapBucket
// Metric : P25 ScrapPct (lower is better)
// No minimum-N filter — thin buckets are flagged by PoolSize
// Source : JobFact_Order_Scrap (built in Section 15B, Tab 3)
// ============================================================

BSP_ScrapBucket_Raw:
NoConcatenate
LOAD
    Plant,
    "WC Object ID",
    ScrapBucket,
    Count(1)                              as ScrapBucket_PoolSize,
    FRACTILE(ScrapPct_Order, 0.25)        as BSP_ScrapPct
RESIDENT JobFact_Order_Scrap
GROUP BY Plant, "WC Object ID", ScrapBucket;

BSP_ScrapBucket_Map:
MAPPING LOAD
    Plant & '|' & [WC Object ID] & '|' & ScrapBucket,
    BSP_ScrapPct
RESIDENT BSP_ScrapBucket_Raw;

BSP_ScrapBucketPool_Map:
MAPPING LOAD
    Plant & '|' & [WC Object ID] & '|' & ScrapBucket,
    ScrapBucket_PoolSize
RESIDENT BSP_ScrapBucket_Raw;

DROP TABLE BSP_ScrapBucket_Raw;
DROP TABLE JobFact_Order_Scrap;


///$tab Step 5
// ============================================================
// SECTION 29: BSP RESOLUTION MAPPING TABLES
// All BSP source tables converted to mapping tables immediately
// Source BSP tables dropped after each group of maps is built
// This resolves all 28 synthetic keys from Step 4
// Key formats:
//   L1 Main    : Plant|WCObjectID|Die
//   L2 Main    : Plant|WCObjectID|BoardTypeGroup|BoardCaliper
//   L3 Main    : Plant|WCObjectID
//   L1 Setup   : Plant|WCObjectID|Die|MROClass
//   L2 Setup   : Plant|WCObjectID|BoardTypeGroup|BoardCaliper|MROClass
//   L3 Setup   : Plant|WCObjectID|MROClass
//   L1 DwnRsn  : Plant|WCObjectID|Die|TimeReasonKey
//   L2 DwnRsn  : Plant|WCObjectID|BoardTypeGroup|BoardCaliper|TimeReasonKey
//   L3 DwnRsn  : Plant|WCObjectID|TimeReasonKey
// ============================================================

BSP_L1_OEE_Map:
MAPPING LOAD Plant & '|' & [WC Object ID] & '|' & Die, L1_BSP_OEE
RESIDENT BSP_Main_L1;

BSP_L1_Speed_Map:
MAPPING LOAD Plant & '|' & [WC Object ID] & '|' & Die, L1_BSP_Speed
RESIDENT BSP_Main_L1;

BSP_L1_DTPct_Map:
MAPPING LOAD Plant & '|' & [WC Object ID] & '|' & Die, L1_BSP_DowntimePct
RESIDENT BSP_Main_L1;

BSP_L1_DTHrs_Map:
MAPPING LOAD Plant & '|' & [WC Object ID] & '|' & Die, L1_BSP_DowntimeHrs
RESIDENT BSP_Main_L1;

BSP_L1_ScrapRate_Map:
MAPPING LOAD Plant & '|' & [WC Object ID] & '|' & Die, L1_BSP_ScrapRate
RESIDENT BSP_Main_L1;

BSP_L1_RunCount_Map:
MAPPING LOAD Plant & '|' & [WC Object ID] & '|' & Die, L1_RunCount
RESIDENT BSP_Main_L1;

DROP TABLE BSP_Main_L1;

BSP_L2_OEE_Map:
MAPPING LOAD Plant & '|' & [WC Object ID] & '|' & [Board Type Group] & '|' & [Board Caliper] & '|' & L2_ExtraDim, L2_BSP_OEE
RESIDENT BSP_Main_L2;

BSP_L2_Speed_Map:
MAPPING LOAD Plant & '|' & [WC Object ID] & '|' & [Board Type Group] & '|' & [Board Caliper] & '|' & L2_ExtraDim, L2_BSP_Speed
RESIDENT BSP_Main_L2;

BSP_L2_DTPct_Map:
MAPPING LOAD Plant & '|' & [WC Object ID] & '|' & [Board Type Group] & '|' & [Board Caliper] & '|' & L2_ExtraDim, L2_BSP_DowntimePct
RESIDENT BSP_Main_L2;

BSP_L2_DTHrs_Map:
MAPPING LOAD Plant & '|' & [WC Object ID] & '|' & [Board Type Group] & '|' & [Board Caliper] & '|' & L2_ExtraDim, L2_BSP_DowntimeHrs
RESIDENT BSP_Main_L2;

BSP_L2_ScrapRate_Map:
MAPPING LOAD Plant & '|' & [WC Object ID] & '|' & [Board Type Group] & '|' & [Board Caliper] & '|' & L2_ExtraDim, L2_BSP_ScrapRate
RESIDENT BSP_Main_L2;

BSP_L2_RunCount_Map:
MAPPING LOAD Plant & '|' & [WC Object ID] & '|' & [Board Type Group] & '|' & [Board Caliper] & '|' & L2_ExtraDim, L2_RunCount
RESIDENT BSP_Main_L2;

DROP TABLE BSP_Main_L2;

BSP_L3_OEE_Map:
MAPPING LOAD Plant & '|' & [WC Object ID], L3_BSP_OEE
RESIDENT BSP_Main_L3;

BSP_L3_Speed_Map:
MAPPING LOAD Plant & '|' & [WC Object ID], L3_BSP_Speed
RESIDENT BSP_Main_L3;

BSP_L3_DTPct_Map:
MAPPING LOAD Plant & '|' & [WC Object ID], L3_BSP_DowntimePct
RESIDENT BSP_Main_L3;

BSP_L3_DTHrs_Map:
MAPPING LOAD Plant & '|' & [WC Object ID], L3_BSP_DowntimeHrs
RESIDENT BSP_Main_L3;

BSP_L3_ScrapRate_Map:
MAPPING LOAD Plant & '|' & [WC Object ID], L3_BSP_ScrapRate
RESIDENT BSP_Main_L3;

BSP_L3_RunCount_Map:
MAPPING LOAD Plant & '|' & [WC Object ID], L3_RunCount
RESIDENT BSP_Main_L3;

DROP TABLE BSP_Main_L3;

// L1 key for Avg MR Time includes MaterialDescription to narrow grain
BSP_L1_SetupHrsEv_Map:
MAPPING LOAD Plant & '|' & [WC Object ID] & '|' & Die & '|' & MROClass & '|' & MaterialDescription, L1_BSP_SetupHrsPerEvent
RESIDENT BSP_Setup_L1;

DROP TABLE BSP_Setup_L1;

BSP_L2_SetupHrsEv_Map:
MAPPING LOAD Plant & '|' & [WC Object ID] & '|' & [Board Type Group] & '|' & [Board Caliper] & '|' & L2_ExtraDim & '|' & MROClass, L2_BSP_SetupHrsPerEvent
RESIDENT BSP_Setup_L2;

DROP TABLE BSP_Setup_L2;

BSP_L3_SetupHrsEv_Map:
MAPPING LOAD Plant & '|' & [WC Object ID] & '|' & MROClass, L3_BSP_SetupHrsPerEvent
RESIDENT BSP_Setup_L3;

DROP TABLE BSP_Setup_L3;

BSP_L1_DwnRsn_Map:
MAPPING LOAD Plant & '|' & [WC Object ID] & '|' & Die & '|' & [Time Plant Reason Key], L1_BSP_ReasonDownPct
RESIDENT BSP_DownReason_L1;

DROP TABLE BSP_DownReason_L1;

BSP_L2_DwnRsn_Map:
MAPPING LOAD Plant & '|' & [WC Object ID] & '|' & [Board Type Group] & '|' & [Board Caliper] & '|' & L2_ExtraDim & '|' & [Time Plant Reason Key], L2_BSP_ReasonDownPct
RESIDENT BSP_DownReason_L2;

DROP TABLE BSP_DownReason_L2;

BSP_L3_DwnRsn_Map:
MAPPING LOAD Plant & '|' & [WC Object ID] & '|' & [Time Plant Reason Key], L3_BSP_ReasonDownPct
RESIDENT BSP_DownReason_L3;

DROP TABLE BSP_DownReason_L3;

// ============================================================
// SECTION 29C: AVG BLANKET WASH TIME BSP MAPPING TABLES
// ============================================================

BSP_L1_BlanketWashTime_Map:
MAPPING LOAD Plant & '|' & [WC Object ID] & '|' & Die, L1_BSP_BlanketWashTime
RESIDENT BSP_BlanketWashTime_L1;
DROP TABLE BSP_BlanketWashTime_L1;

BSP_L2_BlanketWashTime_Map:
MAPPING LOAD Plant & '|' & [WC Object ID] & '|' & [Board Type Group] & '|' & [Board Caliper] & '|' & L2_ExtraDim, L2_BSP_BlanketWashTime
RESIDENT BSP_BlanketWashTime_L2;
DROP TABLE BSP_BlanketWashTime_L2;

BSP_L3_BlanketWashTime_Map:
MAPPING LOAD Plant & '|' & [WC Object ID], L3_BSP_BlanketWashTime
RESIDENT BSP_BlanketWashTime_L3;
DROP TABLE BSP_BlanketWashTime_L3;


// ============================================================
// SECTION 29D: AVG FEEDER TRIP TIME BSP MAPPING TABLES
// ============================================================

BSP_L1_FeederTripTime_Map:
MAPPING LOAD Plant & '|' & [WC Object ID] & '|' & Die, L1_BSP_FeederTripTime
RESIDENT BSP_FeederTripTime_L1;
DROP TABLE BSP_FeederTripTime_L1;

BSP_L2_FeederTripTime_Map:
MAPPING LOAD Plant & '|' & [WC Object ID] & '|' & [Board Type Group] & '|' & [Board Caliper] & '|' & L2_ExtraDim, L2_BSP_FeederTripTime
RESIDENT BSP_FeederTripTime_L2;
DROP TABLE BSP_FeederTripTime_L2;

BSP_L3_FeederTripTime_Map:
MAPPING LOAD Plant & '|' & [WC Object ID], L3_BSP_FeederTripTime
RESIDENT BSP_FeederTripTime_L3;
DROP TABLE BSP_FeederTripTime_L3;



// ============================================================
// SECTION 30: WEEKLY MACHINE+DIE KPI AGGREGATION
// Grain  : WeekStart + Plant + WC Object ID + Die
// Purpose: Per-die actual KPI and SchedHours for weighted BSP
// ============================================================

WeeklyDieKPI:
NoConcatenate
LOAD
    WeekStart(Date, 0, $(vWeekStartDay))                                                        as WeekStart,
    Plant,
    "WC Object ID",
    Die,
    Only(Department)                                                                            as Department,
    Only("Carton Style")                                                                        as CartonStyle,
    Max(NumberUp)                                                                               as NumberUp,
    Max("Board Type Group")                                                                     as "Board Type Group",
    Max("Board Caliper")                                                                        as "Board Caliper",
    Max(MROClass)                                                                               as MROClass,
    Only(MaterialDescription)                                                                   as MaterialDescription,
    Sum(SchedHours)                                                                             as Wk_Die_SchedHours,
    Sum(GoodQty_OEE)                                                                            as Wk_Die_GoodQty,
    Sum(TotalQty_OEE)                                                                           as Wk_Die_TotalQty,
    Sum(ScrapQty_OEE)                                                                           as Wk_Die_ScrapQty,
    Sum(RunHours)                                                                               as Wk_Die_RunHours,
    Sum(DownHours)                                                                              as Wk_Die_DownHours,
    Sum(SetupHours)                                                                             as Wk_Die_SetupHours,
    Sum(SetupCount)                                                                             as Wk_Die_SetupCount,
    Sum(OEE_Denom)                                                                              as Wk_Die_OEE_Denom,
    Sum(Perf_Denom)                                                                             as Wk_Die_Perf_Denom
RESIDENT JobFact_Scoring
GROUP BY WeekStart(Date, 0, $(vWeekStartDay)), Plant, "WC Object ID", Die;


// ============================================================
// SECTION 31: BSP RESOLUTION PER DIE PER WEEK
// Three-level fallback applied per KPI per die
// Coalesce returns first non-null across L1 → L2 → L3
// Confidence numeric: 3=HIGH(L1), 2=MEDIUM(L2), 1=LOW(L3), 0=NONE
// CoveredSchedHours = SchedHours only where OEE BSP resolved
// Used as numerator in machine-week coverage % calculation
// ============================================================

WeeklyDieBSP:
NoConcatenate
LOAD
    WeekStart,
    Plant,
    "WC Object ID",
    Die,
    Department,
    CartonStyle,
    NumberUp,
    "Board Type Group",
    "Board Caliper",
    MROClass,
    MaterialDescription,
    Wk_Die_SchedHours,
    Wk_Die_OEE_Denom,
    Wk_Die_Perf_Denom,
    Wk_Die_GoodQty,
    Wk_Die_TotalQty,
    Wk_Die_ScrapQty,
    Wk_Die_RunHours,
    Wk_Die_DownHours,
    Wk_Die_SetupHours,
    Wk_Die_SetupCount,

    If(Match(Department, 'Gluer', 'Window'),                    Text(CartonStyle),
        If(Match(Department, 'Sheetfed Cutting', 'Web Cutting'), Text(NumberUp),
           ''))                                                                                  as L2_ExtraDim,

    Coalesce(
        ApplyMap('BSP_L1_OEE_Map',      Plant & '|' & [WC Object ID] & '|' & Die, Null()),
        ApplyMap('BSP_L2_OEE_Map',      Plant & '|' & [WC Object ID] & '|' & [Board Type Group] & '|' & [Board Caliper] & '|' &
            If(Match(Department, 'Gluer', 'Window'), Text(CartonStyle),
                If(Match(Department, 'Sheetfed Cutting', 'Web Cutting'), Text(NumberUp), '')), Null()),
        ApplyMap('BSP_L3_OEE_Map',      Plant & '|' & [WC Object ID], Null()))                  as Die_BSP_OEE,

    Coalesce(
        ApplyMap('BSP_L1_Speed_Map',    Plant & '|' & [WC Object ID] & '|' & Die, Null()),
        ApplyMap('BSP_L2_Speed_Map',    Plant & '|' & [WC Object ID] & '|' & [Board Type Group] & '|' & [Board Caliper] & '|' &
            If(Match(Department, 'Gluer', 'Window'), Text(CartonStyle),
                If(Match(Department, 'Sheetfed Cutting', 'Web Cutting'), Text(NumberUp), '')), Null()),
        ApplyMap('BSP_L3_Speed_Map',    Plant & '|' & [WC Object ID], Null()))                  as Die_BSP_Speed,

    Coalesce(
        ApplyMap('BSP_L1_DTPct_Map',    Plant & '|' & [WC Object ID] & '|' & Die, Null()),
        ApplyMap('BSP_L2_DTPct_Map',    Plant & '|' & [WC Object ID] & '|' & [Board Type Group] & '|' & [Board Caliper] & '|' &
            If(Match(Department, 'Gluer', 'Window'), Text(CartonStyle),
                If(Match(Department, 'Sheetfed Cutting', 'Web Cutting'), Text(NumberUp), '')), Null()),
        ApplyMap('BSP_L3_DTPct_Map',    Plant & '|' & [WC Object ID], Null()))                  as Die_BSP_DowntimePct,

    Coalesce(
        ApplyMap('BSP_L1_DTHrs_Map',    Plant & '|' & [WC Object ID] & '|' & Die, Null()),
        ApplyMap('BSP_L2_DTHrs_Map',    Plant & '|' & [WC Object ID] & '|' & [Board Type Group] & '|' & [Board Caliper] & '|' &
            If(Match(Department, 'Gluer', 'Window'), Text(CartonStyle),
                If(Match(Department, 'Sheetfed Cutting', 'Web Cutting'), Text(NumberUp), '')), Null()),
        ApplyMap('BSP_L3_DTHrs_Map',    Plant & '|' & [WC Object ID], Null()))                  as Die_BSP_DowntimeHrs,

    Coalesce(
        ApplyMap('BSP_L1_ScrapRate_Map',Plant & '|' & [WC Object ID] & '|' & Die, Null()),
        ApplyMap('BSP_L2_ScrapRate_Map',Plant & '|' & [WC Object ID] & '|' & [Board Type Group] & '|' & [Board Caliper] & '|' &
            If(Match(Department, 'Gluer', 'Window'), Text(CartonStyle),
                If(Match(Department, 'Sheetfed Cutting', 'Web Cutting'), Text(NumberUp), '')), Null()),
        ApplyMap('BSP_L3_ScrapRate_Map',Plant & '|' & [WC Object ID], Null()))                  as Die_BSP_ScrapRate,

    Coalesce(
        ApplyMap('BSP_L1_SetupHrsEv_Map',Plant & '|' & [WC Object ID] & '|' & Die & '|' & MROClass & '|' & MaterialDescription, Null()),
        ApplyMap('BSP_L2_SetupHrsEv_Map',Plant & '|' & [WC Object ID] & '|' & [Board Type Group] & '|' & [Board Caliper] & '|' &
            If(Match(Department, 'Gluer', 'Window'), Text(CartonStyle),
                If(Match(Department, 'Sheetfed Cutting', 'Web Cutting'), Text(NumberUp), '')) & '|' & MROClass, Null()),
        ApplyMap('BSP_L3_SetupHrsEv_Map',Plant & '|' & [WC Object ID] & '|' & MROClass, Null())) as Die_BSP_SetupHrsPerEvent,

    Coalesce(
        ApplyMap('BSP_L1_BlanketWashTime_Map', Plant & '|' & [WC Object ID] & '|' & Die, Null()),
        ApplyMap('BSP_L2_BlanketWashTime_Map', Plant & '|' & [WC Object ID] & '|' & [Board Type Group] & '|' & [Board Caliper] & '|' &
            If(Match(Department, 'Gluer', 'Window'), Text(CartonStyle),
                If(Match(Department, 'Sheetfed Cutting', 'Web Cutting'), Text(NumberUp), '')), Null()),
        ApplyMap('BSP_L3_BlanketWashTime_Map', Plant & '|' & [WC Object ID], Null()))             as Die_BSP_BlanketWashTime,

    Coalesce(
        ApplyMap('BSP_L1_FeederTripTime_Map',  Plant & '|' & [WC Object ID] & '|' & Die, Null()),
        ApplyMap('BSP_L2_FeederTripTime_Map',  Plant & '|' & [WC Object ID] & '|' & [Board Type Group] & '|' & [Board Caliper] & '|' &
            If(Match(Department, 'Gluer', 'Window'), Text(CartonStyle),
                If(Match(Department, 'Sheetfed Cutting', 'Web Cutting'), Text(NumberUp), '')), Null()),
        ApplyMap('BSP_L3_FeederTripTime_Map',  Plant & '|' & [WC Object ID], Null()))             as Die_BSP_FeederTripTime,

    // Confidence level for OEE used as proxy for all main KPIs
    // 3 = HIGH (L1 resolved), 2 = MEDIUM (L2), 1 = LOW (L3), 0 = NONE
    If(Not IsNull(ApplyMap('BSP_L1_OEE_Map', Plant & '|' & [WC Object ID] & '|' & Die, Null())), 3,
        If(Not IsNull(ApplyMap('BSP_L2_OEE_Map', Plant & '|' & [WC Object ID] & '|' & [Board Type Group] & '|' & [Board Caliper] & '|' &
            If(Match(Department, 'Gluer', 'Window'), Text(CartonStyle),
                If(Match(Department, 'Sheetfed Cutting', 'Web Cutting'), Text(NumberUp), '')), Null())), 2,
            If(Not IsNull(ApplyMap('BSP_L3_OEE_Map', Plant & '|' & [WC Object ID], Null())), 1,
                0)))                                                                             as Die_BSP_ConfScore,

    // Pool size (run count) at the level that resolved OEE BSP for this die
    Coalesce(
        ApplyMap('BSP_L1_RunCount_Map', Plant & '|' & [WC Object ID] & '|' & Die, Null()),
        ApplyMap('BSP_L2_RunCount_Map', Plant & '|' & [WC Object ID] & '|' & [Board Type Group] & '|' & [Board Caliper] & '|' &
            If(Match(Department, 'Gluer', 'Window'), Text(CartonStyle),
                If(Match(Department, 'Sheetfed Cutting', 'Web Cutting'), Text(NumberUp), '')), Null()),
        ApplyMap('BSP_L3_RunCount_Map', Plant & '|' & [WC Object ID], Null()))                  as Die_BSP_PoolSize,

    // SchedHours counted only for dies where OEE BSP was resolved
    If(Not IsNull(Coalesce(
        ApplyMap('BSP_L1_OEE_Map', Plant & '|' & [WC Object ID] & '|' & Die, Null()),
        ApplyMap('BSP_L2_OEE_Map', Plant & '|' & [WC Object ID] & '|' & [Board Type Group] & '|' & [Board Caliper] & '|' &
            If(Match(Department, 'Gluer', 'Window'), Text(CartonStyle),
                If(Match(Department, 'Sheetfed Cutting', 'Web Cutting'), Text(NumberUp), '')), Null()),
        ApplyMap('BSP_L3_OEE_Map', Plant & '|' & [WC Object ID], Null()))),
        Wk_Die_SchedHours, 0)                                                                   as CoveredSchedHours
RESIDENT WeeklyDieKPI;

DROP TABLE WeeklyDieKPI;

DROP MAPPING TABLE BSP_L1_OEE_Map;
DROP MAPPING TABLE BSP_L1_Speed_Map;
DROP MAPPING TABLE BSP_L1_DTPct_Map;
DROP MAPPING TABLE BSP_L1_DTHrs_Map;
DROP MAPPING TABLE BSP_L1_ScrapRate_Map;
DROP MAPPING TABLE BSP_L1_RunCount_Map;
DROP MAPPING TABLE BSP_L2_OEE_Map;
DROP MAPPING TABLE BSP_L2_Speed_Map;
DROP MAPPING TABLE BSP_L2_DTPct_Map;
DROP MAPPING TABLE BSP_L2_DTHrs_Map;
DROP MAPPING TABLE BSP_L2_ScrapRate_Map;
DROP MAPPING TABLE BSP_L2_RunCount_Map;
DROP MAPPING TABLE BSP_L3_OEE_Map;
DROP MAPPING TABLE BSP_L3_Speed_Map;
DROP MAPPING TABLE BSP_L3_DTPct_Map;
DROP MAPPING TABLE BSP_L3_DTHrs_Map;
DROP MAPPING TABLE BSP_L3_ScrapRate_Map;
DROP MAPPING TABLE BSP_L3_RunCount_Map;
DROP MAPPING TABLE BSP_L1_SetupHrsEv_Map;
DROP MAPPING TABLE BSP_L2_SetupHrsEv_Map;
DROP MAPPING TABLE BSP_L3_SetupHrsEv_Map;
DROP MAPPING TABLE BSP_L1_BlanketWashTime_Map;
DROP MAPPING TABLE BSP_L2_BlanketWashTime_Map;
DROP MAPPING TABLE BSP_L3_BlanketWashTime_Map;
DROP MAPPING TABLE BSP_L1_FeederTripTime_Map;
DROP MAPPING TABLE BSP_L2_FeederTripTime_Map;
DROP MAPPING TABLE BSP_L3_FeederTripTime_Map;


// ============================================================
// SECTION 32: WEIGHTED BSP — MACHINE + WEEK LEVEL
// Aggregates die-level BSP to machine-week using SchedHours
// Only covered dies contribute to weighted numerator
// Coverage % flags low-confidence insights to front end
// Confidence score = coverage-weighted average of die scores
// ============================================================

WeeklyMachineBSP:
NoConcatenate
LOAD
    WeekStart,
    Plant,
    "WC Object ID",
    Sum(Wk_Die_SchedHours)                                                                      as Wk_TotalSchedHours,
    Sum(CoveredSchedHours)                                                                      as Wk_CoveredSchedHours,
    If(Sum(Wk_Die_SchedHours) > 0,
        Sum(CoveredSchedHours) / Sum(Wk_Die_SchedHours), 0)                                    as BSP_CoveragePct,

    If(Sum(If(Not IsNull(Die_BSP_OEE),          Wk_Die_SchedHours, 0)) > 0,
        Sum(If(Not IsNull(Die_BSP_OEE),          Wk_Die_SchedHours * Die_BSP_OEE, 0)) /
        Sum(If(Not IsNull(Die_BSP_OEE),          Wk_Die_SchedHours, 0)), Null())               as Wk_BSP_OEE,

    If(Sum(If(Not IsNull(Die_BSP_Speed),         Wk_Die_SchedHours, 0)) > 0,
        Sum(If(Not IsNull(Die_BSP_Speed),         Wk_Die_SchedHours * Die_BSP_Speed, 0)) /
        Sum(If(Not IsNull(Die_BSP_Speed),         Wk_Die_SchedHours, 0)), Null())              as Wk_BSP_Speed,

    If(Sum(If(Not IsNull(Die_BSP_DowntimePct),   Wk_Die_SchedHours, 0)) > 0,
        Sum(If(Not IsNull(Die_BSP_DowntimePct),   Wk_Die_SchedHours * Die_BSP_DowntimePct, 0)) /
        Sum(If(Not IsNull(Die_BSP_DowntimePct),   Wk_Die_SchedHours, 0)), Null())              as Wk_BSP_DowntimePct,

    If(Sum(If(Not IsNull(Die_BSP_DowntimeHrs),   Wk_Die_SchedHours, 0)) > 0,
        Sum(If(Not IsNull(Die_BSP_DowntimeHrs),   Wk_Die_SchedHours * Die_BSP_DowntimeHrs, 0)) /
        Sum(If(Not IsNull(Die_BSP_DowntimeHrs),   Wk_Die_SchedHours, 0)), Null())              as Wk_BSP_DowntimeHrs,

    If(Sum(If(Not IsNull(Die_BSP_ScrapRate),     Wk_Die_SchedHours, 0)) > 0,
        Sum(If(Not IsNull(Die_BSP_ScrapRate),     Wk_Die_SchedHours * Die_BSP_ScrapRate, 0)) /
        Sum(If(Not IsNull(Die_BSP_ScrapRate),     Wk_Die_SchedHours, 0)), Null())              as Wk_BSP_ScrapRate,

    If(Sum(If(Not IsNull(Die_BSP_SetupHrsPerEvent), Wk_Die_SchedHours, 0)) > 0,
        Sum(If(Not IsNull(Die_BSP_SetupHrsPerEvent), Wk_Die_SchedHours * Die_BSP_SetupHrsPerEvent, 0)) /
        Sum(If(Not IsNull(Die_BSP_SetupHrsPerEvent), Wk_Die_SchedHours, 0)), Null())           as Wk_BSP_SetupHrsPerEvent,

    If(Sum(If(Not IsNull(Die_BSP_BlanketWashTime), Wk_Die_SchedHours, 0)) > 0,
        Sum(If(Not IsNull(Die_BSP_BlanketWashTime), Wk_Die_SchedHours * Die_BSP_BlanketWashTime, 0)) /
        Sum(If(Not IsNull(Die_BSP_BlanketWashTime), Wk_Die_SchedHours, 0)), Null())            as Wk_BSP_BlanketWashTime,

    If(Sum(If(Not IsNull(Die_BSP_FeederTripTime),  Wk_Die_SchedHours, 0)) > 0,
        Sum(If(Not IsNull(Die_BSP_FeederTripTime),  Wk_Die_SchedHours * Die_BSP_FeederTripTime, 0)) /
        Sum(If(Not IsNull(Die_BSP_FeederTripTime),  Wk_Die_SchedHours, 0)), Null())            as Wk_BSP_FeederTripTime,

    // Coverage-weighted confidence score across all dies in week
    If(Sum(Wk_Die_SchedHours) > 0,
        Sum(Die_BSP_ConfScore * Wk_Die_SchedHours) / Sum(Wk_Die_SchedHours), 0)               as BSP_ConfScore,

    // SchedHours-weighted pool size — low values signal a thin BSP benchmark
    If(Sum(Wk_Die_SchedHours) > 0,
        Sum(Die_BSP_PoolSize * Wk_Die_SchedHours) / Sum(Wk_Die_SchedHours), Null())           as BSP_PoolSize
RESIDENT WeeklyDieBSP
GROUP BY WeekStart, Plant, "WC Object ID";

DROP TABLE WeeklyDieBSP;


// ============================================================
// SECTION 33: WEEKLY MACHINE KPI AGGREGATION FOR TREND
// Grain  : WeekStart + Plant + WC Object ID
// All 13 completed weeks included
// Actual KPI values computed per week for streak input
// ============================================================

WeeklyMachineKPI:
NoConcatenate
LOAD
    WeekStart(Date, 0, $(vWeekStartDay))                                                        as WeekStart,
    Plant,
    "WC Object ID",
    Sum(SchedHours)                                                                             as Wk_SchedHours,
    Sum(RunHours)                                                                               as Wk_RunHours,
    Sum(DownHours)                                                                              as Wk_DownHours,
    Sum(SetupHours)                                                                             as Wk_SetupHours,
    Sum(SetupCount)                                                                             as Wk_SetupCount,
    Sum(GoodQty_OEE)                                                                            as Wk_GoodQty,
    Sum(TotalQty_OEE)                                                                           as Wk_TotalQty,
    Sum(ScrapQty_OEE)                                                                           as Wk_ScrapQty,
    Sum(OEE_Denom)                                                                              as Wk_OEE_Denom,
    Sum(Perf_Denom)                                                                             as Wk_Perf_Denom,
    If(Sum(OEE_Denom)    > 0, Sum(GoodQty_OEE)  / Sum(OEE_Denom),    Null())                   as Wk_OEE,
    If(Sum(SchedHours)   > 0, Sum(RunHours)      / Sum(SchedHours),   Null())                   as Wk_Availability,
    If(Sum(Perf_Denom)   > 0, Sum(TotalQty_OEE) / Sum(Perf_Denom),   Null())                   as Wk_Performance,
    If(Sum(TotalQty_OEE) > 0, Sum(GoodQty_OEE)  / Sum(TotalQty_OEE), Null())                   as Wk_Quality,
    If(Sum(RunHours)     > 0, Sum(TotalQty_OEE) / Sum(RunHours),      Null())                   as Wk_Speed,
    If(Sum(SchedHours)   > 0, (Sum(DownHours) + Sum(SetupDownHours)) / Sum(SchedHours), Null())  as Wk_DowntimePct,
    Sum(DownHours) + Sum(SetupDownHours)                                                         as Wk_DowntimeHrs,
    If(Sum(TotalQty_OEE) > 0, Sum(ScrapQty_OEE) / Sum(TotalQty_OEE), Null())                   as Wk_ScrapRate,
    If(Sum(SetupCount)   > 0, Sum(SetupHours)    / Sum(SetupCount),   Null())                   as Wk_SetupHrsPerEvent,
    If(Sum(BlanketWashEvents) > 0, Sum(BlanketWashHours) / Sum(BlanketWashEvents), Null())       as Wk_BlanketWashTime,
    If(Sum(FeederTripEvents)  > 0, Sum(FeederTripHours)  / Sum(FeederTripEvents),  Null())       as Wk_FeederTripTime,
    Sum(BlanketWashEvents)                                                                       as Wk_BlanketWashEvents,
    Sum(FeederTripEvents)                                                                        as Wk_FeederTripEvents,
    Max(MaxSpeed)                                                                               as Wk_MaxSpeed
RESIDENT JobFact_Scoring
GROUP BY WeekStart(Date, 0, $(vWeekStartDay)), Plant, "WC Object ID";

DROP TABLE JobFact_Scoring;


// ============================================================
// SECTION 34: SORT FOR STREAK CALCULATION
// Must sort by Plant + WC Object ID + WeekStart ASC
// before Peek() is applied — order is critical for
// consecutive-week streak logic to work correctly
// ============================================================

WeeklyMachineKPI_Sorted:
NoConcatenate
LOAD *
RESIDENT WeeklyMachineKPI
ORDER BY Plant, "WC Object ID", WeekStart ASC;

DROP TABLE WeeklyMachineKPI;


// ============================================================
// SECTION 35: TREND STREAK CALCULATION USING PEEK()
// Compares each week to the previous week per machine
// Streak increments when KPI deteriorates, resets to 0 otherwise
// Higher-is-better KPIs: deterioration = current < previous
// Lower-is-better KPIs: deterioration = current > previous
// Null weeks do not increment or continue streaks
// The streak value at the most recent week = consecutive
// deteriorating weeks ending at that week
// 4-week signal capped at Min(Streak, 4) in Step 6
// ============================================================

WeeklyMachineTrend:
NoConcatenate
LOAD
    WeekStart,
    Plant,
    "WC Object ID",
    Wk_OEE,
    Wk_Speed,
    Wk_DowntimePct,
    Wk_DowntimeHrs,
    Wk_ScrapRate,
    Wk_SetupHrsPerEvent,
    Wk_BlanketWashTime,
    Wk_FeederTripTime,
    Wk_SchedHours,
    Wk_RunHours,
    Wk_SetupCount,
    Wk_BlanketWashEvents,
    Wk_FeederTripEvents,
    Wk_MaxSpeed,

    // Higher is better — lower = deterioration
    If(Plant = Peek('Plant') AND [WC Object ID] = Peek('WC Object ID')
        AND Not IsNull(Wk_OEE) AND Not IsNull(Peek('Wk_OEE'))
        AND Wk_OEE < Peek('Wk_OEE'),
        Peek('Streak_OEE') + 1, 0)                                                              as Streak_OEE,

    If(Plant = Peek('Plant') AND [WC Object ID] = Peek('WC Object ID')
        AND Not IsNull(Wk_Speed) AND Not IsNull(Peek('Wk_Speed'))
        AND Wk_Speed < Peek('Wk_Speed'),
        Peek('Streak_Speed') + 1, 0)                                                            as Streak_Speed,

    // Lower is better — higher = deterioration
    If(Plant = Peek('Plant') AND [WC Object ID] = Peek('WC Object ID')
        AND Not IsNull(Wk_DowntimePct) AND Not IsNull(Peek('Wk_DowntimePct'))
        AND Wk_DowntimePct > Peek('Wk_DowntimePct'),
        Peek('Streak_DowntimePct') + 1, 0)                                                      as Streak_DowntimePct,

    If(Plant = Peek('Plant') AND [WC Object ID] = Peek('WC Object ID')
        AND Not IsNull(Wk_DowntimeHrs) AND Not IsNull(Peek('Wk_DowntimeHrs'))
        AND Wk_DowntimeHrs > Peek('Wk_DowntimeHrs'),
        Peek('Streak_DowntimeHrs') + 1, 0)                                                      as Streak_DowntimeHrs,

    If(Plant = Peek('Plant') AND [WC Object ID] = Peek('WC Object ID')
        AND Not IsNull(Wk_ScrapRate) AND Not IsNull(Peek('Wk_ScrapRate'))
        AND Wk_ScrapRate > Peek('Wk_ScrapRate'),
        Peek('Streak_ScrapRate') + 1, 0)                                                        as Streak_ScrapRate,

    If(Plant = Peek('Plant') AND [WC Object ID] = Peek('WC Object ID')
        AND Not IsNull(Wk_SetupHrsPerEvent) AND Not IsNull(Peek('Wk_SetupHrsPerEvent'))
        AND Wk_SetupHrsPerEvent > Peek('Wk_SetupHrsPerEvent'),
        Peek('Streak_SetupHrsPerEvent') + 1, 0)                                                 as Streak_SetupHrsPerEvent,

    If(Plant = Peek('Plant') AND [WC Object ID] = Peek('WC Object ID')
        AND Not IsNull(Wk_BlanketWashTime) AND Not IsNull(Peek('Wk_BlanketWashTime'))
        AND Wk_BlanketWashTime > Peek('Wk_BlanketWashTime'),
        Peek('Streak_BlanketWashTime') + 1, 0)                                                  as Streak_BlanketWashTime,

    If(Plant = Peek('Plant') AND [WC Object ID] = Peek('WC Object ID')
        AND Not IsNull(Wk_FeederTripTime) AND Not IsNull(Peek('Wk_FeederTripTime'))
        AND Wk_FeederTripTime > Peek('Wk_FeederTripTime'),
        Peek('Streak_FeederTripTime') + 1, 0)                                                   as Streak_FeederTripTime

RESIDENT WeeklyMachineKPI_Sorted;

DROP TABLE WeeklyMachineKPI_Sorted;
///$tab Step 6
// ============================================================
// SECTION 36: RESOLVE FINAL SYNTHETIC KEY
// LEFT JOIN WeeklyMachineTrend onto WeeklyMachineBSP
// Combines BSP values + actual weekly KPIs + streaks
// Resolves $Syn 1 = Plant + WC Object ID + WeekStart
// ============================================================

LEFT JOIN (WeeklyMachineBSP)
LOAD
    Plant,
    "WC Object ID",
    WeekStart,
    Wk_OEE,
    Wk_Speed,
    Wk_DowntimePct,
    Wk_DowntimeHrs,
    Wk_ScrapRate,
    Wk_SetupHrsPerEvent,
    Wk_BlanketWashTime,
    Wk_FeederTripTime,
    Wk_SchedHours,
    Wk_RunHours,
    Wk_SetupCount,
    Wk_BlanketWashEvents,
    Wk_FeederTripEvents,
    Wk_MaxSpeed,
    Streak_OEE,
    Streak_Speed,
    Streak_DowntimePct,
    Streak_DowntimeHrs,
    Streak_ScrapRate,
    Streak_SetupHrsPerEvent,
    Streak_BlanketWashTime,
    Streak_FeederTripTime
RESIDENT WeeklyMachineTrend;

DROP TABLE WeeklyMachineTrend;


// ============================================================
// SECTION 37: CURRENT PERIOD AGGREGATION
// 1-week actuals + BSP per machine
// Streak taken from most recent completed week only
// Coverage and confidence from most recent week
// ============================================================

CurrentPeriod:
NoConcatenate
LOAD
    Plant,
    "WC Object ID",
    Avg(Wk_BSP_OEE)                                                                             as Cur_BSP_OEE,
    Avg(Wk_BSP_Speed)                                                                           as Cur_BSP_Speed,
    Avg(Wk_BSP_DowntimePct)                                                                     as Cur_BSP_DowntimePct,
    Avg(Wk_BSP_DowntimeHrs)                                                                     as Cur_BSP_DowntimeHrs,
    Avg(Wk_BSP_ScrapRate)                                                                       as Cur_BSP_ScrapRate,
    Avg(Wk_BSP_SetupHrsPerEvent)                                                                as Cur_BSP_SetupHrsPerEvent,
    Avg(Wk_BSP_BlanketWashTime)                                                                 as Cur_BSP_BlanketWashTime,
    Avg(Wk_BSP_FeederTripTime)                                                                  as Cur_BSP_FeederTripTime,
    Avg(Wk_OEE)                                                                                 as Cur_OEE,
    Avg(Wk_Speed)                                                                               as Cur_Speed,
    Avg(Wk_DowntimePct)                                                                         as Cur_DowntimePct,
    Avg(Wk_DowntimeHrs)                                                                         as Cur_DowntimeHrs,
    Avg(Wk_ScrapRate)                                                                           as Cur_ScrapRate,
    Avg(Wk_SetupHrsPerEvent)                                                                    as Cur_SetupHrsPerEvent,
    Avg(Wk_BlanketWashTime)                                                                     as Cur_BlanketWashTime,
    Avg(Wk_FeederTripTime)                                                                      as Cur_FeederTripTime,
    Sum(Wk_BlanketWashEvents)                                                                   as Cur_BlanketWashEvents,
    Sum(Wk_FeederTripEvents)                                                                    as Cur_FeederTripEvents,
    Sum(Wk_SchedHours)                                                                          as Cur_SchedHours,
    Sum(Wk_RunHours)                                                                            as Cur_RunHours,
    Sum(Wk_SetupCount)                                                                          as Cur_SetupEventCount,
    Max(If(WeekStart = $(vLastWeekStart), Wk_MaxSpeed,             Null()))                     as Cur_MaxSpeed,
    Max(If(WeekStart = $(vLastWeekStart), Streak_OEE,              Null()))                     as Streak_OEE,
    Max(If(WeekStart = $(vLastWeekStart), Streak_Speed,            Null()))                     as Streak_Speed,
    Max(If(WeekStart = $(vLastWeekStart), Streak_DowntimePct,      Null()))                     as Streak_DowntimePct,
    Max(If(WeekStart = $(vLastWeekStart), Streak_DowntimeHrs,      Null()))                     as Streak_DowntimeHrs,
    Max(If(WeekStart = $(vLastWeekStart), Streak_ScrapRate,        Null()))                     as Streak_ScrapRate,
    Max(If(WeekStart = $(vLastWeekStart), Streak_SetupHrsPerEvent, Null()))                     as Streak_SetupHrsPerEvent,
    Max(If(WeekStart = $(vLastWeekStart), Streak_BlanketWashTime,  Null()))                     as Streak_BlanketWashTime,
    Max(If(WeekStart = $(vLastWeekStart), Streak_FeederTripTime,   Null()))                     as Streak_FeederTripTime,
    If(Sum(Wk_TotalSchedHours) > 0,
        Sum(Wk_CoveredSchedHours) / Sum(Wk_TotalSchedHours), 0)                                as Cur_BSP_CoveragePct,
    Max(If(WeekStart = $(vLastWeekStart), BSP_ConfScore,           Null()))                     as Cur_BSP_ConfScore,
    Max(If(WeekStart = $(vLastWeekStart), BSP_PoolSize,            Null()))                     as Cur_BSP_PoolSize
RESIDENT WeeklyMachineBSP
WHERE WeekStart >= $(v2WeekStart) AND WeekStart < $(vCurrentWeekStart)
GROUP BY Plant, "WC Object ID";

DROP TABLE WeeklyMachineBSP;


// ============================================================
// SECTION 38: UTILITY MAPS FOR STEP 6
// Department for insight records — WcAttributes still in memory
// Plant for reason aggregation — rebuilt from QVD (760 rows)
// ============================================================

[Dept_IR_Temp]:
NoConcatenate
LOAD
    "WC Object ID",
    "Hierarchy" & '-' & If(Len(Trim(Format)) = 0, 'NA', Format)    as DepartmentKey
FROM [lib://Data - PP:DataFiles/Models/Asset Utilization/model Asset Utilization - WcAttributes.qvd]
(qvd);

LEFT JOIN ([Dept_IR_Temp])
LOAD
    DepartmentKey,
    Department
FROM [lib://Shared Connections:Office_365_Sharepoint - Reporting - User Defined Credentials/BSS_AMC_MFG/Master Data/Control Room/OEE Dashboard Lookups/Department_lookup.xlsx]
(ooxml, embedded labels, table is Department);

Department_IR_Map:
MAPPING LOAD
    "WC Object ID",
    Department
RESIDENT [Dept_IR_Temp];

DROP TABLE [Dept_IR_Temp];

PlantWC_IR_Map:
MAPPING LOAD
    "WC Object ID",
    "Plant-WC"
RESIDENT WcAttributes;

Plant_Reason_Map:
MAPPING LOAD
    "WC Object ID",
    Plant
FROM [lib://Data - PP:DataFiles/Models/Asset Utilization/model Asset Utilization - WcAttributes.qvd]
(qvd);

// Rebuild board attribute mapping tables — dropped at end of Step 3, needed
// here for L1 (Die) and L2 (Board Type Group + Board Caliper) reason BSP keys
[PlantMaterial_Rsn]:
NoConcatenate
LOAD
    "Plant Material Key"    as PltMatKey,
    Material,
    "Board Type"
FROM [lib://Data - PP:DataFiles/Models/Asset Utilization/model Asset Utilization - PlantMaterial.qvd]
(qvd);

[Materials_Rsn]:
NoConcatenate
LOAD
    Material,
    "Board Caliper"
FROM [lib://Data - PP:DataFiles/Models/Asset Utilization/model Asset Utilization - Materials.qvd]
(qvd);

[BoardTypes_Rsn]:
NoConcatenate
LOAD
    "Board Type",
    "Board Type Group"
FROM [lib://Data - PP:DataFiles/Models/Asset Utilization/model Asset Utilization - BoardTypes.qvd]
(qvd);

BoardType_Rsn_Map:
MAPPING LOAD PltMatKey, "Board Type"       RESIDENT [PlantMaterial_Rsn];
Material_Rsn_Map:
MAPPING LOAD PltMatKey, Material           RESIDENT [PlantMaterial_Rsn];
BoardTypeGroup_Rsn_Map:
MAPPING LOAD "Board Type", "Board Type Group" RESIDENT [BoardTypes_Rsn];
BoardCaliper_Rsn_Map:
MAPPING LOAD Material, "Board Caliper"    RESIDENT [Materials_Rsn];

DROP TABLE [PlantMaterial_Rsn];
DROP TABLE [Materials_Rsn];
DROP TABLE [BoardTypes_Rsn];


// ============================================================
// SECTION 39: REASON DENOMINATOR MAPS — 1-WEEK WINDOW
// TotalSchedHrs_Map : Total SchedHours per machine over full
//   1-week window — used as denominator for downtime reason %
//   Must be total (not avg) to match summed ReasonDownHours
// ============================================================

[ReasonDenom_Raw]:
NoConcatenate
LOAD
    "WC Object ID",
    Sum(If(fSched = 1,
        "Time - Run" + "Time - Down" + "Time - Setup"
        + "Time - Setup Down" + "Time - Non-Crewed", 0))               as TotalSchedHrs_2wk
FROM [$(vFactQVD)]
(qvd)
WHERE Date >= $(v2WeekStart) AND Date < $(vCurrentWeekStart)
GROUP BY "WC Object ID";

TotalSchedHrs_Rsn_Map:
MAPPING LOAD
    ApplyMap('Plant_Reason_Map', "WC Object ID", 'Unknown') & '|' & [WC Object ID],
    TotalSchedHrs_2wk
RESIDENT [ReasonDenom_Raw];

DROP TABLE [ReasonDenom_Raw];

// Die-level SchedHours for 2-week window — used as weights when
// aggregating die+reason level BSP back up to machine+reason level
[CurPeriod_DieStats_Raw]:
NoConcatenate
LOAD
    "WC Object ID",
    Die,
    "Plant Material Key"                                                    as PltMatKey,
    Sum(If(fSched = 1,
        "Time - Run" + "Time - Down" + "Time - Setup"
        + "Time - Setup Down" + "Time - Non-Crewed", 0))                    as Die_SchedHrs_2wk
FROM [$(vFactQVD)]
(qvd)
WHERE Date >= $(v2WeekStart) AND Date < $(vCurrentWeekStart)
GROUP BY "WC Object ID", Die, "Plant Material Key";

DieSchedHrs_Rsn_Map:
MAPPING LOAD
    ApplyMap('Plant_Reason_Map', "WC Object ID", 'Unknown') & '|' & [WC Object ID] & '|' & Die & '|' & PltMatKey,
    Die_SchedHrs_2wk
RESIDENT [CurPeriod_DieStats_Raw];

DROP TABLE [CurPeriod_DieStats_Raw];


// ============================================================
// SECTION 40: CURRENT PERIOD DOWNTIME REASON AGGREGATION
// Aggregated at Die + Reason grain to enable 3-level BSP fallback
// L1 key : Plant|WC|Die|ReasonKey
// L2 key : Plant|WC|BoardTypeGroup|BoardCaliper|ReasonKey
// L3 key : Plant|WC|ReasonKey
// BSP weighted by die SchedHours when rolling up to machine+reason
// MRO setup reason rows excluded — not downtime events
// Denominator : TotalSchedHrs_Rsn_Map (1-week total SchedHrs)
// ============================================================

CurPeriod_DwnReason_DieLvl_Raw:
NoConcatenate
LOAD
    "WC Object ID",
    Die,
    "Plant Material Key"                                                    as PltMatKey,
    "Time Plant Reason Key",
    Only("Carton Style")                                                    as CartonStyle,
    Max(ApplyMap('OrderOp_NumberUp_Map', "Order Operation Key", Null()))    as NumberUp,
    Sum(If(fSched = 1, "Time - Down", 0))          as Cur_ReasonDownHours
FROM [$(vFactQVD)]
(qvd)
WHERE Date >= $(v2WeekStart) AND Date < $(vCurrentWeekStart)
    AND Len(Trim("Time Plant Reason Key")) > 0
    AND Not WildMatch("Time Plant Reason Key", '*MR0*', '*PQBW*', '*PLG5*', '*PLDF*', '*PLF*')
GROUP BY "WC Object ID", Die, "Plant Material Key", "Time Plant Reason Key";

CurPeriod_DwnReason_DieLvl:
NoConcatenate
LOAD
    ApplyMap('Plant_Reason_Map', "WC Object ID", 'Unknown')                 as Plant,
    "WC Object ID",
    "Time Plant Reason Key",
    Cur_ReasonDownHours,
    ApplyMap('DieSchedHrs_Rsn_Map',
        ApplyMap('Plant_Reason_Map', "WC Object ID", 'Unknown')
        & '|' & [WC Object ID] & '|' & Die & '|' & PltMatKey, 0)           as Die_SchedHrs_2wk,
    Coalesce(
        ApplyMap('BSP_L1_DwnRsn_Map',
            ApplyMap('Plant_Reason_Map', "WC Object ID", 'Unknown') & '|'
            & [WC Object ID] & '|' & Die & '|' & [Time Plant Reason Key], Null()),
        ApplyMap('BSP_L2_DwnRsn_Map',
            ApplyMap('Plant_Reason_Map', "WC Object ID", 'Unknown') & '|'
            & [WC Object ID] & '|'
            & ApplyMap('BoardTypeGroup_Rsn_Map', ApplyMap('BoardType_Rsn_Map', PltMatKey, Null()), Null()) & '|'
            & ApplyMap('BoardCaliper_Rsn_Map',   ApplyMap('Material_Rsn_Map',  PltMatKey, Null()), Null()) & '|'
            & If(Match(ApplyMap('Department_Rsn_Map', "WC Object ID", 'Unknown'), 'Gluer', 'Window'),
                    Text(CartonStyle),
                If(Match(ApplyMap('Department_Rsn_Map', "WC Object ID", 'Unknown'), 'Sheetfed Cutting', 'Web Cutting'),
                    Text(NumberUp),
                   '')) & '|'
            & [Time Plant Reason Key], Null()),
        ApplyMap('BSP_L3_DwnRsn_Map',
            ApplyMap('Plant_Reason_Map', "WC Object ID", 'Unknown') & '|'
            & [WC Object ID] & '|' & [Time Plant Reason Key], Null())
    )                                                                       as Rsn_BSP_DownPct
RESIDENT CurPeriod_DwnReason_DieLvl_Raw;

DROP TABLE CurPeriod_DwnReason_DieLvl_Raw;

CurPeriod_DwnReason:
NoConcatenate
LOAD
    Plant,
    "WC Object ID",
    "Time Plant Reason Key"                                                 as tPltRsnKey,
    Sum(Cur_ReasonDownHours)                                                as Cur_ReasonDownHours,
    ApplyMap('TotalSchedHrs_Rsn_Map',
        Plant & '|' & [WC Object ID], Null())                               as TotalSchedHrs_2wk,
    If(Sum(If(Not IsNull(Rsn_BSP_DownPct), Die_SchedHrs_2wk, 0)) > 0,
        Sum(If(Not IsNull(Rsn_BSP_DownPct), Die_SchedHrs_2wk * Rsn_BSP_DownPct, 0)) /
        Sum(If(Not IsNull(Rsn_BSP_DownPct), Die_SchedHrs_2wk, 0)), Null()) as Rsn_BSP_DownPct
RESIDENT CurPeriod_DwnReason_DieLvl
GROUP BY Plant, "WC Object ID", "Time Plant Reason Key";

DROP TABLE CurPeriod_DwnReason_DieLvl;
DROP MAPPING TABLE BSP_L1_DwnRsn_Map;
DROP MAPPING TABLE BSP_L2_DwnRsn_Map;
DROP MAPPING TABLE BSP_L3_DwnRsn_Map;


// ============================================================
// SECTION 40B: CURRENT-PERIOD ORDER-LEVEL SCRAP AGGREGATION
// Grain  : Plant + WC Object ID (via Plant_Reason_Map)
// Window : v2WeekStart to current week (1-week actuals)
// Filter : SetupCount = 1 (single-setup orders only)
// Bucket BSP looked up from BSP_ScrapBucket_Map (Tab 4)
// Result joined onto CurrentPeriod for Section 42 (Tab 6)
// ============================================================

CurPeriod_OrderScrap_Agg:
NoConcatenate
LOAD
    "WC Object ID",
    "Order",
    Sum(If(If(IsNull(fSched), 2, fSched) >= 1, "Yield in OEE UOM" + "Scrap in OEE UOM", 0))  as TotalSheets,
    Sum(If(If(IsNull(fSched), 2, fSched) >= 1, "Scrap in OEE UOM", 0))                        as ScrapSheets,
    Sum(If(fSched = 1, "Setup Count", 0))                                                      as SetupCount
FROM [$(vFactQVD)]
(qvd)
WHERE Date >= $(v2WeekStart) AND Date < $(vCurrentWeekStart)
GROUP BY "WC Object ID", "Order";

CurPeriod_OrderScrap:
NoConcatenate
LOAD
    ApplyMap('Plant_Reason_Map', "WC Object ID", 'Unknown')                           as Plant,
    "WC Object ID",
    "Order",
    TotalSheets,
    ScrapSheets,
    $(vScrapBucket(TotalSheets))                                                      as ScrapBucket,
    ApplyMap('BSP_ScrapBucket_Map',
        ApplyMap('Plant_Reason_Map', "WC Object ID", 'Unknown')
        & '|' & [WC Object ID] & '|' & $(vScrapBucket(TotalSheets)), Null())         as BSP_ScrapPct_Order,
    If(Not IsNull(ApplyMap('BSP_ScrapBucket_Map',
        ApplyMap('Plant_Reason_Map', "WC Object ID", 'Unknown')
        & '|' & [WC Object ID] & '|' & $(vScrapBucket(TotalSheets)), Null())),
        ApplyMap('BSP_ScrapBucket_Map',
            ApplyMap('Plant_Reason_Map', "WC Object ID", 'Unknown')
            & '|' & [WC Object ID] & '|' & $(vScrapBucket(TotalSheets)), Null())
            * TotalSheets, Null())                                                    as ExpectedScrap_Order
RESIDENT CurPeriod_OrderScrap_Agg
WHERE SetupCount = 1 AND TotalSheets > 0;

DROP TABLE CurPeriod_OrderScrap_Agg;

CurPeriod_ScrapBucket:
NoConcatenate
LOAD
    Plant,
    "WC Object ID",
    Sum(ScrapSheets)                                                   as Cur_ActualScrapSheets,
    Sum(ExpectedScrap_Order)                                           as Cur_ExpectedScrapSheets,
    Sum(TotalSheets)                                                   as Cur_ScrapTotalSheets,
    Sum(If(Not IsNull(BSP_ScrapPct_Order), TotalSheets, 0))           as Cur_ScrapCoveredSheets,
    Avg(If(Not IsNull(BSP_ScrapPct_Order),
        ApplyMap('BSP_ScrapBucketPool_Map',
            Plant & '|' & [WC Object ID] & '|' & ScrapBucket, Null()), Null()))      as Cur_ScrapBucketPoolSize
RESIDENT CurPeriod_OrderScrap
GROUP BY Plant, "WC Object ID";

DROP TABLE CurPeriod_OrderScrap;
DROP MAPPING TABLE BSP_ScrapBucket_Map;
DROP MAPPING TABLE BSP_ScrapBucketPool_Map;

LEFT JOIN (CurrentPeriod)
LOAD
    Plant,
    "WC Object ID",
    Cur_ActualScrapSheets,
    Cur_ExpectedScrapSheets,
    Cur_ScrapTotalSheets,
    Cur_ScrapCoveredSheets,
    Cur_ScrapBucketPoolSize
RESIDENT CurPeriod_ScrapBucket;

DROP TABLE CurPeriod_ScrapBucket;


// ============================================================
// SECTION 41B: 4-WEEK REASON STREAK
// Per reason (Plant + WC + ReasonKey), counts how many of the
// last 4 weeks the reason's weekly rate exceeded its 2-week
// rolled-up BSP benchmark. Streak_4wk ∈ [0, 4].
//
// Scope: Downtime (tPltRsnKey) only.
// Feeder/Blanket and Scrap Reason streaks are not computed here.
// ============================================================

// -- Weekly SchedHrs per machine (denominator for downtime-reason weekly rate)
WeeklySchedHrs_Rsn_Raw:
NoConcatenate
LOAD
    WeekStart(Date, 0, $(vWeekStartDay))                                as WeekStart,
    "WC Object ID",
    Sum(If(fSched = 1,
        "Time - Run" + "Time - Down" + "Time - Setup"
        + "Time - Setup Down" + "Time - Non-Crewed", 0))                as Wk_SchedHrs
FROM [$(vFactQVD)]
(qvd)
WHERE Date >= $(v4WeekStart) AND Date < $(vCurrentWeekStart)
GROUP BY WeekStart(Date, 0, $(vWeekStartDay)), "WC Object ID";

WeeklySchedHrs_Rsn_Map:
MAPPING LOAD
    WeekStart & '|' & [WC Object ID],
    Wk_SchedHrs
RESIDENT WeeklySchedHrs_Rsn_Raw;

DROP TABLE WeeklySchedHrs_Rsn_Raw;

// -- Machine-rolled BSP benchmarks keyed by Plant|WC|ReasonKey
Rsn_BSP_Down_Map:
MAPPING LOAD
    Plant & '|' & [WC Object ID] & '|' & tPltRsnKey,
    Rsn_BSP_DownPct
RESIDENT CurPeriod_DwnReason
WHERE Not IsNull(Rsn_BSP_DownPct);

// -- Weekly downtime-reason aggregation
WeeklyDwnReason_Raw:
NoConcatenate
LOAD
    WeekStart(Date, 0, $(vWeekStartDay))                                as WeekStart,
    "WC Object ID",
    "Time Plant Reason Key",
    Sum(If(fSched = 1, "Time - Down", 0))       as Wk_ReasonDownHrs
FROM [$(vFactQVD)]
(qvd)
WHERE Date >= $(v4WeekStart) AND Date < $(vCurrentWeekStart)
    AND Len(Trim("Time Plant Reason Key")) > 0
    AND Not WildMatch("Time Plant Reason Key", '*MR0*', '*PQBW*', '*PLG5*', '*PLDF*', '*PLF*')
GROUP BY WeekStart(Date, 0, $(vWeekStartDay)), "WC Object ID", "Time Plant Reason Key";

Rsn_Down_Streak_Raw:
NoConcatenate
LOAD
    "WC Object ID",
    "Time Plant Reason Key"                                             as tPltRsnKey,
    Sum(
        If(ApplyMap('WeeklySchedHrs_Rsn_Map', WeekStart & '|' & [WC Object ID], 0) > 0
           AND ApplyMap('Rsn_BSP_Down_Map',
                   ApplyMap('Plant_Reason_Map', "WC Object ID", 'Unknown')
                   & '|' & [WC Object ID] & '|' & "Time Plant Reason Key", 0) > 0
           AND (Wk_ReasonDownHrs
                / ApplyMap('WeeklySchedHrs_Rsn_Map', WeekStart & '|' & [WC Object ID], 1))
               > ApplyMap('Rsn_BSP_Down_Map',
                   ApplyMap('Plant_Reason_Map', "WC Object ID", 'Unknown')
                   & '|' & [WC Object ID] & '|' & "Time Plant Reason Key", 0),
           1, 0)
    )                                                                   as Streak_4wk
RESIDENT WeeklyDwnReason_Raw
GROUP BY "WC Object ID", "Time Plant Reason Key";

Rsn_Down_Streak_Map:
MAPPING LOAD
    ApplyMap('Plant_Reason_Map', "WC Object ID", 'Unknown')
        & '|' & [WC Object ID] & '|' & tPltRsnKey,
    Streak_4wk
RESIDENT Rsn_Down_Streak_Raw;

DROP TABLE WeeklyDwnReason_Raw;
DROP TABLE Rsn_Down_Streak_Raw;

DROP MAPPING TABLE WeeklySchedHrs_Rsn_Map;
DROP MAPPING TABLE Rsn_BSP_Down_Map;


DROP MAPPING TABLE Plant_Reason_Map;
DROP MAPPING TABLE Department_Rsn_Map;
DROP MAPPING TABLE OrderOp_NumberUp_Map;
DROP MAPPING TABLE TotalSchedHrs_Rsn_Map;
DROP MAPPING TABLE DieSchedHrs_Rsn_Map;
DROP MAPPING TABLE BoardType_Rsn_Map;
DROP MAPPING TABLE Material_Rsn_Map;
DROP MAPPING TABLE BoardTypeGroup_Rsn_Map;
DROP MAPPING TABLE BoardCaliper_Rsn_Map;


// ============================================================
// SECTION 42: MAIN KPI INSIGHT RECORDS — UNPIVOT
// DowntimeHrs KPI removed — Downtime % is sufficient
// Plant - WC added via PlantWC_IR_Map for readability
// Confidence Label derived inline from ConfScore:
//   >= 2.5 = HIGH (L1), >= 1.5 = MEDIUM (L2),
//   >= 0.5 = LOW (L3), else = Insufficient History
// ============================================================

InsightRecords_Raw:
NoConcatenate
LOAD
    Plant & '|' & [WC Object ID] & '|' & Date($(v2WeekStart), 'YYYY-MM-DD') & '|OEE'          as Insight_ID,
    Plant,
    "WC Object ID",
    ApplyMap('PlantWC_IR_Map', "WC Object ID", 'Unknown')                                       as "Plant - WC",
    ApplyMap('Department_IR_Map', "WC Object ID", 'Unknown')                                    as Department,
    Date($(v2WeekStart), 'YYYY-MM-DD')                                                          as Period_Start,
    'OEE'                                                                                       as KPI_Name,
    'Outcome'                                                                                   as KPI_Category,
    Cur_OEE                                                                                     as Cur_Actual,
    Cur_BSP_OEE                                                                                 as BSP_Benchmark,
    Num(Cur_OEE,         '0.00%')                                                               as Cur_Actual_Fmt,
    Num(Cur_BSP_OEE,     '0.00%')                                                               as BSP_Benchmark_Fmt,
    (Cur_BSP_OEE - Cur_OEE) / Cur_BSP_OEE * 100                                                 as Gap_Pct,
    (Cur_BSP_OEE - Cur_OEE) * Cur_SchedHours * Cur_MaxSpeed                                    as Sheet_Gap,
    RangeMin(If(IsNull(Streak_OEE), 0, Streak_OEE), 4)                                          as Streak_4wk,
    Cur_SchedHours,
    Cur_BSP_CoveragePct,
    Cur_BSP_ConfScore,
    Cur_BSP_PoolSize,
    If(Cur_BSP_ConfScore >= 2.5, 'HIGH',
        If(Cur_BSP_ConfScore >= 1.5, 'MEDIUM',
            If(Cur_BSP_ConfScore >= 0.5, 'LOW',
                'Insufficient History')))                                                        as BSP_Confidence
RESIDENT CurrentPeriod
WHERE Not IsNull(Cur_BSP_OEE) AND Not IsNull(Cur_OEE)
    AND Cur_OEE < Cur_BSP_OEE
    AND Cur_BSP_CoveragePct > $(vMinCoverage);

Concatenate (InsightRecords_Raw)
LOAD
    Plant & '|' & [WC Object ID] & '|' & Date($(v2WeekStart), 'YYYY-MM-DD') & '|SPEED'         as Insight_ID,
    Plant,
    "WC Object ID",
    ApplyMap('PlantWC_IR_Map', "WC Object ID", 'Unknown')                                       as "Plant - WC",
    ApplyMap('Department_IR_Map', "WC Object ID", 'Unknown')                                    as Department,
    Date($(v2WeekStart), 'YYYY-MM-DD')                                                          as Period_Start,
    'Speed'                                                                                     as KPI_Name,
    'Lever - OEE'                                                                               as KPI_Category,
    Cur_Speed                                                                                   as Cur_Actual,
    Cur_BSP_Speed                                                                               as BSP_Benchmark,
    Cur_Speed                                                                                   as Cur_Actual_Fmt,
    Cur_BSP_Speed                                                                               as BSP_Benchmark_Fmt,
    (Cur_BSP_Speed - Cur_Speed) / Cur_BSP_Speed * 100                                           as Gap_Pct,
    If(Cur_BSP_Speed > 0, (Cur_BSP_Speed - Cur_Speed) * Cur_RunHours, 0)                      as Sheet_Gap,
    RangeMin(If(IsNull(Streak_Speed), 0, Streak_Speed), 4)                                      as Streak_4wk,
    Cur_SchedHours,
    Cur_BSP_CoveragePct,
    Cur_BSP_ConfScore,
    Cur_BSP_PoolSize,
    If(Cur_BSP_ConfScore >= 2.5, 'HIGH',
        If(Cur_BSP_ConfScore >= 1.5, 'MEDIUM',
            If(Cur_BSP_ConfScore >= 0.5, 'LOW',
                'Insufficient History')))                                                        as BSP_Confidence
RESIDENT CurrentPeriod
WHERE Not IsNull(Cur_BSP_Speed) AND Not IsNull(Cur_Speed)
    AND Cur_Speed < Cur_BSP_Speed
    AND Cur_BSP_CoveragePct > $(vMinCoverage);

Concatenate (InsightRecords_Raw)
LOAD
    Plant & '|' & [WC Object ID] & '|' & Date($(v2WeekStart), 'YYYY-MM-DD') & '|DOWNTIMEPCT'   as Insight_ID,
    Plant,
    "WC Object ID",
    ApplyMap('PlantWC_IR_Map', "WC Object ID", 'Unknown')                                       as "Plant - WC",
    ApplyMap('Department_IR_Map', "WC Object ID", 'Unknown')                                    as Department,
    Date($(v2WeekStart), 'YYYY-MM-DD')                                                          as Period_Start,
    'Downtime %'                                                                                as KPI_Name,
    'Lever - OEE'                                                                               as KPI_Category,
    Cur_DowntimePct                                                                             as Cur_Actual,
    Cur_BSP_DowntimePct                                                                         as BSP_Benchmark,
    Num(Cur_DowntimePct,     '0.00%')                                                           as Cur_Actual_Fmt,
    Num(Cur_BSP_DowntimePct, '0.00%')                                                           as BSP_Benchmark_Fmt,
    (Cur_DowntimePct - Cur_BSP_DowntimePct) / Cur_BSP_DowntimePct * 100                         as Gap_Pct,
    (Cur_DowntimePct - Cur_BSP_DowntimePct) * Cur_SchedHours * Cur_BSP_Speed                   as Sheet_Gap,
    RangeMin(If(IsNull(Streak_DowntimePct), 0, Streak_DowntimePct), 4)                          as Streak_4wk,
    Cur_SchedHours,
    Cur_BSP_CoveragePct,
    Cur_BSP_ConfScore,
    Cur_BSP_PoolSize,
    If(Cur_BSP_ConfScore >= 2.5, 'HIGH',
        If(Cur_BSP_ConfScore >= 1.5, 'MEDIUM',
            If(Cur_BSP_ConfScore >= 0.5, 'LOW',
                'Insufficient History')))                                                        as BSP_Confidence
RESIDENT CurrentPeriod
WHERE Not IsNull(Cur_BSP_DowntimePct) AND Not IsNull(Cur_DowntimePct)
    AND Cur_DowntimePct > Cur_BSP_DowntimePct
    AND Cur_BSP_CoveragePct > $(vMinCoverage);

Concatenate (InsightRecords_Raw)
LOAD
    Plant & '|' & [WC Object ID] & '|' & Date($(v2WeekStart), 'YYYY-MM-DD') & '|SCRAPRATE'     as Insight_ID,
    Plant,
    "WC Object ID",
    ApplyMap('PlantWC_IR_Map', "WC Object ID", 'Unknown')                                       as "Plant - WC",
    ApplyMap('Department_IR_Map', "WC Object ID", 'Unknown')                                    as Department,
    Date($(v2WeekStart), 'YYYY-MM-DD')                                                          as Period_Start,
    'Scrap Loss'                                                                                as KPI_Name,
    'Lever - OEE'                                                                               as KPI_Category,
    Cur_ScrapRate                                                                               as Cur_Actual,
    If(Cur_ScrapTotalSheets > 0, Cur_ExpectedScrapSheets / Cur_ScrapTotalSheets, Null())        as BSP_Benchmark,
    Num(Cur_ScrapRate, '0.00%')                                                                 as Cur_Actual_Fmt,
    Num(If(Cur_ScrapTotalSheets > 0, Cur_ExpectedScrapSheets / Cur_ScrapTotalSheets, Null()), '0.00%')  as BSP_Benchmark_Fmt,
    If(Cur_ExpectedScrapSheets > 0,
        (Cur_ActualScrapSheets - Cur_ExpectedScrapSheets) / Cur_ExpectedScrapSheets * 100, 0)   as Gap_Pct,
    Cur_ActualScrapSheets - Cur_ExpectedScrapSheets                                             as Sheet_Gap,
    0                                                                                           as Streak_4wk,
    Cur_SchedHours,
    If(Cur_ScrapTotalSheets > 0, Cur_ScrapCoveredSheets / Cur_ScrapTotalSheets, 0)              as Cur_BSP_CoveragePct,
    Null()                                                                                      as Cur_BSP_ConfScore,
    Cur_ScrapBucketPoolSize                                                                     as Cur_BSP_PoolSize,
    Null()                                                                                      as BSP_Confidence
RESIDENT CurrentPeriod
WHERE Cur_ScrapTotalSheets > 0
    AND (Cur_ActualScrapSheets - Cur_ExpectedScrapSheets) > 0
    AND Cur_ScrapCoveredSheets / Cur_ScrapTotalSheets > $(vMinCoverage);

Concatenate (InsightRecords_Raw)
LOAD
    Plant & '|' & [WC Object ID] & '|' & Date($(v2WeekStart), 'YYYY-MM-DD') & '|SETUPHRSEV'    as Insight_ID,
    Plant,
    "WC Object ID",
    ApplyMap('PlantWC_IR_Map', "WC Object ID", 'Unknown')                                       as "Plant - WC",
    ApplyMap('Department_IR_Map', "WC Object ID", 'Unknown')                                    as Department,
    Date($(v2WeekStart), 'YYYY-MM-DD')                                                          as Period_Start,
    'Avg MR Time'                                                                               as KPI_Name,
    'Lever - OEE'                                                                               as KPI_Category,
    Cur_SetupHrsPerEvent                                                                        as Cur_Actual,
    Cur_BSP_SetupHrsPerEvent                                                                    as BSP_Benchmark,
    Cur_SetupHrsPerEvent                                                                        as Cur_Actual_Fmt,
    Cur_BSP_SetupHrsPerEvent                                                                    as BSP_Benchmark_Fmt,
    (Cur_SetupHrsPerEvent - Cur_BSP_SetupHrsPerEvent) / Cur_BSP_SetupHrsPerEvent * 100          as Gap_Pct,
    (Cur_SetupHrsPerEvent - Cur_BSP_SetupHrsPerEvent) * Cur_SetupEventCount * Cur_BSP_Speed     as Sheet_Gap,
    RangeMin(If(IsNull(Streak_SetupHrsPerEvent), 0, Streak_SetupHrsPerEvent), 4)                as Streak_4wk,
    Cur_SchedHours,
    Cur_BSP_CoveragePct,
    Cur_BSP_ConfScore,
    Cur_BSP_PoolSize,
    If(Cur_BSP_ConfScore >= 2.5, 'HIGH',
        If(Cur_BSP_ConfScore >= 1.5, 'MEDIUM',
            If(Cur_BSP_ConfScore >= 0.5, 'LOW',
                'Insufficient History')))                                                        as BSP_Confidence
RESIDENT CurrentPeriod
WHERE Not IsNull(Cur_BSP_SetupHrsPerEvent) AND Not IsNull(Cur_SetupHrsPerEvent)
    AND Cur_SetupHrsPerEvent > Cur_BSP_SetupHrsPerEvent
    AND Cur_BSP_CoveragePct > $(vMinCoverage);

Concatenate (InsightRecords_Raw)
LOAD
    Plant & '|' & [WC Object ID] & '|' & Date($(v2WeekStart), 'YYYY-MM-DD') & '|BWTTIME'       as Insight_ID,
    Plant,
    "WC Object ID",
    ApplyMap('PlantWC_IR_Map', "WC Object ID", 'Unknown')                                       as "Plant - WC",
    ApplyMap('Department_IR_Map', "WC Object ID", 'Unknown')                                    as Department,
    Date($(v2WeekStart), 'YYYY-MM-DD')                                                          as Period_Start,
    'Avg Blanket Wash Time'                                                                     as KPI_Name,
    'Lever - Downtime %'                                                                        as KPI_Category,
    Cur_BlanketWashTime                                                                         as Cur_Actual,
    Cur_BSP_BlanketWashTime                                                                     as BSP_Benchmark,
    Cur_BlanketWashTime                                                                         as Cur_Actual_Fmt,
    Cur_BSP_BlanketWashTime                                                                     as BSP_Benchmark_Fmt,
    If(Cur_BSP_BlanketWashTime > 0, (Cur_BlanketWashTime - Cur_BSP_BlanketWashTime) / Cur_BSP_BlanketWashTime * 100, 0) as Gap_Pct,
    If(Cur_BSP_BlanketWashTime > 0,
        (Cur_BlanketWashTime - Cur_BSP_BlanketWashTime) * Cur_BlanketWashEvents * Cur_BSP_Speed, 0) as Sheet_Gap,
    RangeMin(If(IsNull(Streak_BlanketWashTime), 0, Streak_BlanketWashTime), 4)                  as Streak_4wk,
    Cur_SchedHours,
    Cur_BSP_CoveragePct,
    Cur_BSP_ConfScore,
    Cur_BSP_PoolSize,
    If(Cur_BSP_ConfScore >= 2.5, 'HIGH',
        If(Cur_BSP_ConfScore >= 1.5, 'MEDIUM',
            If(Cur_BSP_ConfScore >= 0.5, 'LOW',
                'Insufficient History')))                                                        as BSP_Confidence
RESIDENT CurrentPeriod
WHERE Not IsNull(Cur_BSP_BlanketWashTime) AND Not IsNull(Cur_BlanketWashTime)
    AND Cur_BlanketWashTime > Cur_BSP_BlanketWashTime
    AND Cur_BSP_CoveragePct > $(vMinCoverage);

Concatenate (InsightRecords_Raw)
LOAD
    Plant & '|' & [WC Object ID] & '|' & Date($(v2WeekStart), 'YYYY-MM-DD') & '|FTTIME'        as Insight_ID,
    Plant,
    "WC Object ID",
    ApplyMap('PlantWC_IR_Map', "WC Object ID", 'Unknown')                                       as "Plant - WC",
    ApplyMap('Department_IR_Map', "WC Object ID", 'Unknown')                                    as Department,
    Date($(v2WeekStart), 'YYYY-MM-DD')                                                          as Period_Start,
    'Avg Feeder Trip Time'                                                                      as KPI_Name,
    'Lever - Downtime %'                                                                        as KPI_Category,
    Cur_FeederTripTime                                                                          as Cur_Actual,
    Cur_BSP_FeederTripTime                                                                      as BSP_Benchmark,
    Cur_FeederTripTime                                                                          as Cur_Actual_Fmt,
    Cur_BSP_FeederTripTime                                                                      as BSP_Benchmark_Fmt,
    If(Cur_BSP_FeederTripTime > 0, (Cur_FeederTripTime - Cur_BSP_FeederTripTime) / Cur_BSP_FeederTripTime * 100, 0) as Gap_Pct,
    If(Cur_BSP_FeederTripTime > 0,
        (Cur_FeederTripTime - Cur_BSP_FeederTripTime) * Cur_FeederTripEvents * Cur_BSP_Speed, 0) as Sheet_Gap,
    RangeMin(If(IsNull(Streak_FeederTripTime), 0, Streak_FeederTripTime), 4)                    as Streak_4wk,
    Cur_SchedHours,
    Cur_BSP_CoveragePct,
    Cur_BSP_ConfScore,
    Cur_BSP_PoolSize,
    If(Cur_BSP_ConfScore >= 2.5, 'HIGH',
        If(Cur_BSP_ConfScore >= 1.5, 'MEDIUM',
            If(Cur_BSP_ConfScore >= 0.5, 'LOW',
                'Insufficient History')))                                                        as BSP_Confidence
RESIDENT CurrentPeriod
WHERE Not IsNull(Cur_BSP_FeederTripTime) AND Not IsNull(Cur_FeederTripTime)
    AND Cur_FeederTripTime > Cur_BSP_FeederTripTime
    AND Cur_BSP_CoveragePct > $(vMinCoverage);

Mach_BSPSpeed_Map:
MAPPING LOAD
    Plant & '|' & [WC Object ID],
    Cur_BSP_Speed
RESIDENT CurrentPeriod;

DROP TABLE CurrentPeriod;

// ============================================================
// SECTION 43: UNIFIED SHEET IMPACT SCORING
// Sheet_Impact = Round(Sheet_Gap, 0.01) — no streak multiplier
// Sheet_Gap per KPI (all results are sheets):
//   OEE              : (BSP - Actual) * Cur_SchedHours * Cur_MaxSpeed
//   Downtime %       : (Actual - BSP) * Cur_SchedHours * Cur_BSP_Speed
//   Scrap Loss       : Sum(ActualScrap) - Sum(ExpectedScrap)  [bucket-weighted, direct sheets]
//   Speed            : (BSP - Actual) * Cur_RunHours
//   Avg MR Time      : (Actual - BSP) * Cur_SetupEventCount * Cur_BSP_Speed
//   Avg Blanket Wash : (Actual - BSP) * Cur_BlanketWashEvents * Cur_BSP_Speed
//   Avg Feeder Trip  : (Actual - BSP) * Cur_FeederTripEvents  * Cur_BSP_Speed
// Streak_4wk is a display field only; does not affect Sheet_Impact
// ============================================================

InsightRecords_Scored:
NoConcatenate
LOAD
    Insight_ID,
    Plant,
    "WC Object ID",
    "Plant - WC",
    Department,
    Period_Start,
    KPI_Name,
    KPI_Category,
    Cur_Actual,
    BSP_Benchmark,
    Gap_Pct,
    Sheet_Gap,
    Streak_4wk,
    Cur_SchedHours,
    Cur_BSP_CoveragePct,
    Cur_BSP_ConfScore,
    Cur_BSP_PoolSize,
    BSP_Confidence,
    Cur_Actual_Fmt,
    BSP_Benchmark_Fmt,
    Null()                                                                                      as Reasons,
    Round(Sheet_Gap, 0.01)                                                                      as Sheet_Impact
RESIDENT InsightRecords_Raw
WHERE Sheet_Gap > 0;

DROP TABLE InsightRecords_Raw;


// ============================================================
// SECTION 44: REASON INSIGHT RECORDS
// Downtime : Cur_Actual = ReasonDownHours / TotalSchedHrs_2wk
// ============================================================


CurSchedHrs_Map:
MAPPING LOAD
    Plant & '|' & [WC Object ID],
    Cur_SchedHours
RESIDENT InsightRecords_Scored;

ReasonInsights_Raw:
NoConcatenate
LOAD
    Plant & '|' & [WC Object ID] & '|' & Date($(v2WeekStart), 'YYYY-MM-DD') & '|DWNRSN|' & tPltRsnKey as Insight_ID,
    Plant,
    "WC Object ID",
    ApplyMap('PlantWC_IR_Map', "WC Object ID", 'Unknown')                                       as "Plant - WC",
    ApplyMap('Department_IR_Map', "WC Object ID", 'Unknown')                                    as Department,
    Date($(v2WeekStart), 'YYYY-MM-DD')                                                          as Period_Start,
    'Downtime Reason'                                                                           as KPI_Name,
    'Lever - Downtime %'                                                                        as KPI_Category,
    ApplyMap('TimeReason_Name_Map', tPltRsnKey, tPltRsnKey)                                     as Reasons,
    If(TotalSchedHrs_2wk > 0, Cur_ReasonDownHours / TotalSchedHrs_2wk, Null())                  as Cur_Actual,
    Rsn_BSP_DownPct                                                                             as BSP_Benchmark,
    Num(If(TotalSchedHrs_2wk > 0, Cur_ReasonDownHours / TotalSchedHrs_2wk, Null()), '0.00%')    as Cur_Actual_Fmt,
    Num(Rsn_BSP_DownPct,                                                               '0.00%') as BSP_Benchmark_Fmt,
    If(Not IsNull(Rsn_BSP_DownPct) AND Rsn_BSP_DownPct > 0
        AND TotalSchedHrs_2wk > 0
        AND Cur_ReasonDownHours / TotalSchedHrs_2wk > Rsn_BSP_DownPct,
        (Cur_ReasonDownHours / TotalSchedHrs_2wk - Rsn_BSP_DownPct) / Rsn_BSP_DownPct * 100, 0) as Gap_Pct,
    RangeMin(ApplyMap('Rsn_Down_Streak_Map',
        Plant & '|' & [WC Object ID] & '|' & tPltRsnKey, 0), 4)                                 as Streak_4wk,
    If(Not IsNull(Rsn_BSP_DownPct) AND Rsn_BSP_DownPct > 0
        AND TotalSchedHrs_2wk > 0
        AND Cur_ReasonDownHours / TotalSchedHrs_2wk > Rsn_BSP_DownPct,
        Round(
            (Cur_ReasonDownHours / TotalSchedHrs_2wk - Rsn_BSP_DownPct) * TotalSchedHrs_2wk
            * ApplyMap('Mach_BSPSpeed_Map', Plant & '|' & [WC Object ID], 0),
            0.01
        ), 0)                                                                                   as Sheet_Impact
RESIDENT CurPeriod_DwnReason
WHERE Not IsNull(Rsn_BSP_DownPct);

DROP TABLE CurPeriod_DwnReason;
DROP MAPPING TABLE Rsn_Down_Streak_Map;


DROP MAPPING TABLE CurSchedHrs_Map;
DROP MAPPING TABLE Mach_BSPSpeed_Map;

// ============================================================
// SECTION 45: RANK MAIN KPI INSIGHTS WITHIN PLANT
// Ranked by Sheet_Impact DESC
// ============================================================

InsightRecords_Sorted:
NoConcatenate
LOAD *
RESIDENT InsightRecords_Scored
ORDER BY Plant, Sheet_Impact DESC;

DROP TABLE InsightRecords_Scored;

MainInsightRecords:
NoConcatenate
LOAD
    Insight_ID,
    Plant,
    "WC Object ID",
    "Plant - WC",
    Department,
    Period_Start,
    KPI_Name,
    KPI_Category,
    Reasons,
    Cur_Actual,
    BSP_Benchmark,
    Cur_Actual_Fmt,
    BSP_Benchmark_Fmt,
    Gap_Pct,
    Streak_4wk,
    Sheet_Impact,
    Cur_BSP_CoveragePct,
    Cur_BSP_ConfScore,
    Cur_BSP_PoolSize,
    BSP_Confidence,
    If(Plant = Peek('Plant'),
        Peek('Insight_Rank') + 1, 1)                                                            as Insight_Rank
RESIDENT InsightRecords_Sorted;

DROP TABLE InsightRecords_Sorted;


// ============================================================
// SECTION 46: RANK REASON INSIGHTS WITHIN MACHINE
// Ranked by Sheet_Impact DESC within (Plant, WC, KPI_Name)
// Top-3 cap applied ONLY to 'Downtime Reason' rows.
// Other reason rows are not capped (one row per machine per metric).
// ============================================================

ReasonInsights_Sorted:
NoConcatenate
LOAD *
RESIDENT ReasonInsights_Raw
WHERE Gap_Pct > 0
ORDER BY Plant, "WC Object ID", KPI_Name, Sheet_Impact DESC;

DROP TABLE ReasonInsights_Raw;

ReasonInsightRecords_All:
NoConcatenate
LOAD
    Insight_ID,
    Plant,
    "WC Object ID",
    "Plant - WC",
    Department,
    Period_Start,
    KPI_Name,
    KPI_Category,
    Reasons,
    Cur_Actual,
    BSP_Benchmark,
    Cur_Actual_Fmt,
    BSP_Benchmark_Fmt,
    Gap_Pct,
    Streak_4wk,
    Sheet_Impact,
    Null()                                                                                      as Cur_BSP_CoveragePct,
    Null()                                                                                      as Cur_BSP_ConfScore,
    Null()                                                                                      as Cur_BSP_PoolSize,
    Null()                                                                                      as BSP_Confidence,
    If(Plant = Peek('Plant') AND [WC Object ID] = Peek('WC Object ID')
        AND KPI_Name = Peek('KPI_Name'),
        Peek('Insight_Rank') + 1, 1)                                                            as Insight_Rank
RESIDENT ReasonInsights_Sorted;

DROP TABLE ReasonInsights_Sorted;

// Top-3 cap for Downtime Reason; keep all others
ReasonInsightRecords:
NoConcatenate
LOAD *
RESIDENT ReasonInsightRecords_All
WHERE
    (KPI_Name = 'Downtime Reason' AND Insight_Rank <= 3)
    OR KPI_Name <> 'Downtime Reason';

DROP TABLE ReasonInsightRecords_All;


// ============================================================
// SECTION 47: COMBINE MAIN + REASON INTO FINAL INSIGHT RECORDS
// ============================================================

InsightRecords:
NoConcatenate
LOAD * RESIDENT MainInsightRecords;

Concatenate (InsightRecords)
LOAD * RESIDENT ReasonInsightRecords;

DROP TABLE MainInsightRecords;
DROP TABLE ReasonInsightRecords;
DROP MAPPING TABLE Department_IR_Map;
DROP MAPPING TABLE PlantWC_IR_Map;
DROP MAPPING TABLE TimeReason_Name_Map;



// ============================================================
// SECTION 48: INCREMENTAL STORE
// Load existing QVD if it exists on SharePoint
// Remove any rows matching current Period_Start to prevent
// duplicate records on reruns within same week
// Concatenate new records and store full history back
// If QVD does not exist yet this is the first ever run
// and only current records are stored
// ============================================================

LET vPeriodStartStr = Date($(v2WeekStart), 'YYYY-MM-DD');

IF FileSize('$(vInsightQVDPath)') > 0 THEN

      [InsightRecords_History]:
      NoConcatenate
      LOAD *
      FROM [$(vInsightQVDPath)]
      (qvd)
      WHERE Period_Start <> '$(vPeriodStartStr)';

      Concatenate ([InsightRecords_History])
      LOAD * RESIDENT InsightRecords;

ELSE
    [InsightRecords_History]:
    NoConcatenate
    LOAD * RESIDENT InsightRecords;
END IF

DROP TABLE InsightRecords;

STORE [InsightRecords_History] INTO [$(vInsightQVDPath)] (qvd);

RENAME TABLE [InsightRecords_History] TO InsightRecords;

TRACE InsightRecords stored successfully — incremental append complete;


///$tab Step 7
// ============================================================
// SECTION 49: MACHINE WEEK SUMMARY
// Materialises a narrow, pivot-wide summary from InsightRecords
// for the current period only (Period_Start = v2WeekStart).
// Output: one row per Plant|WC|Period_Start with:
//   - top-2 Outcome rows (by Sheet_Impact DESC)
//   - top-3 Lever rows (from top-2 Outcomes' pool; fall back to
//     top-3 overall if that pool is empty for the machine)
// Stored as QVD (Qlik mart) + CSV (Python notifier consumption).
// InsightRecords at this point is the full history table (after
// Section 48 RENAME) — all reads filter to $(v2WeekStart).
// ============================================================

// ---- Step A: OEE Sheet_Impact per machine-week ----
// Total_Sheet_Impact = OEE row only. Levers ladder into OEE so summing
// all rows would double-count. OEE Sheet_Impact captures the total loss.

Temp_TotalImpact:
NoConcatenate
LOAD
    Plant,
    [WC Object ID],
    Sum(Sheet_Impact)   as Total_Sheet_Impact
RESIDENT InsightRecords
WHERE Period_Start = $(v2WeekStart)
  AND KPI_Name = 'OEE'
GROUP BY Plant, [WC Object ID];

TotalImpact_Map:
MAPPING LOAD
    Plant & '|' & [WC Object ID],
    Total_Sheet_Impact
RESIDENT Temp_TotalImpact;

DROP TABLE Temp_TotalImpact;


// ---- Step B: rank Outcome rows per machine-week ----
// ORDER BY guarantees Peek() increments correctly within each group

Temp_OutcomeRanked:
NoConcatenate
LOAD
    Plant,
    [WC Object ID],
    KPI_Name                                                        as Outcome_Name,
    Sheet_Impact                                                    as Outcome_Sheets,
    Cur_Actual                                                      as Outcome_CurActual,
    BSP_Benchmark                                                   as Outcome_BSPBenchmark,
    If(Plant = Peek('Plant') AND [WC Object ID] = Peek('WC Object ID'),
       Peek('Outcome_Rank') + 1, 1)                                 as Outcome_Rank
RESIDENT InsightRecords
WHERE Period_Start = $(v2WeekStart) AND KPI_Category = 'Outcome'
ORDER BY Plant, [WC Object ID], Sheet_Impact DESC;


// ---- Step C: outcome position maps ----

Outcome1_Map:
MAPPING LOAD
    Plant & '|' & [WC Object ID],
    Outcome_Name
RESIDENT Temp_OutcomeRanked
WHERE Outcome_Rank = 1;

Outcome1_Sheets_Map:
MAPPING LOAD
    Plant & '|' & [WC Object ID],
    Outcome_Sheets
RESIDENT Temp_OutcomeRanked
WHERE Outcome_Rank = 1;

Outcome1_CurActual_Map:
MAPPING LOAD
    Plant & '|' & [WC Object ID],
    Outcome_CurActual
RESIDENT Temp_OutcomeRanked
WHERE Outcome_Rank = 1;

Outcome1_BSP_Map:
MAPPING LOAD
    Plant & '|' & [WC Object ID],
    Outcome_BSPBenchmark
RESIDENT Temp_OutcomeRanked
WHERE Outcome_Rank = 1;

DROP TABLE Temp_OutcomeRanked;


// ---- Step D: pool levers (those laddering into top-2 Outcomes) ----
// Chr(0) sentinel prevents false match when a machine has only 1 Outcome

Temp_PoolLevers:
NoConcatenate
LOAD
    Plant,
    [WC Object ID],
    KPI_Name                                                        as Lever_Name,
    Reasons                                                         as Lever_Reasons,
    Sheet_Impact                                                    as Lever_Sheets,
    Gap_Pct                                                         as Lever_Gap_Pct,
    Streak_4wk                                                      as Lever_Streak,
    Replace(KPI_Category, 'Lever - ', '')                           as Lever_Parent_Outcome,
    Cur_Actual                                                      as Lever_Cur_Actual,
    BSP_Benchmark                                                   as Lever_BSP_Benchmark
RESIDENT InsightRecords
WHERE Period_Start = $(v2WeekStart)
  AND WildMatch(KPI_Category, 'Lever - *')
  AND Replace(KPI_Category, 'Lever - ', '')
          = ApplyMap('Outcome1_Map', Plant & '|' & [WC Object ID], Chr(0));


// ---- Step E: flag machines that have at least one pool lever ----

HasPoolLevers_Map:
MAPPING LOAD DISTINCT
    Plant & '|' & [WC Object ID],
    1
RESIDENT Temp_PoolLevers;


// ---- Step F: rank pool levers ----

Temp_PoolLeversRanked:
NoConcatenate
LOAD
    Plant,
    [WC Object ID],
    Lever_Name,
    Lever_Reasons,
    Lever_Sheets,
    Lever_Gap_Pct,
    Lever_Streak,
    Lever_Parent_Outcome,
    Lever_Cur_Actual,
    Lever_BSP_Benchmark,
    If(Plant = Peek('Plant') AND [WC Object ID] = Peek('WC Object ID'),
       Peek('Lever_Rank') + 1, 1)                                   as Lever_Rank
RESIDENT Temp_PoolLevers
ORDER BY Plant, [WC Object ID], Lever_Sheets DESC;

DROP TABLE Temp_PoolLevers;


// ---- Step F2: driver-parent map ----
// Picks the highest-Sheet_Impact occurrence of Downtime % among the top-3 OEE levers.
// Used by the email summary clause. Returns Null when Downtime % does not appear in the pool.
// (Scrap Loss has no sub-reasons and no longer triggers driver-parent logic.)

Temp_DriverParent:
NoConcatenate
LOAD
    Plant,
    [WC Object ID],
    FirstSortedValue(Lever_Name,   -Lever_Sheets)  as Driver_Parent_Name,
    FirstSortedValue(Lever_Sheets, -Lever_Sheets)  as Driver_Parent_Sheets
RESIDENT Temp_PoolLeversRanked
WHERE Lever_Rank <= 3 AND Match(Lever_Name, 'Downtime %') > 0
GROUP BY Plant, [WC Object ID];

DriverParent_Name_Map:
MAPPING LOAD
    Plant & '|' & [WC Object ID],
    Driver_Parent_Name
RESIDENT Temp_DriverParent;

DriverParent_Sheets_Map:
MAPPING LOAD
    Plant & '|' & [WC Object ID],
    Driver_Parent_Sheets
RESIDENT Temp_DriverParent;

DROP TABLE Temp_DriverParent;


// ---- Step F3: sub-lever ranked pool ----
// Ranks Downtime % sub-levers (Lever - Downtime %) 1-2 per (Plant, WC, Parent)
// by Sheet_Impact DESC.

Temp_SubLeversRanked:
NoConcatenate
LOAD
    Plant,
    [WC Object ID],
    KPI_Name                                                                as Sub_Name,
    Reasons                                                                 as Sub_Reasons,
    Sheet_Impact                                                            as Sub_Sheets,
    Gap_Pct                                                                 as Sub_Gap_Pct,
    Streak_4wk                                                              as Sub_Streak,
    Replace(KPI_Category, 'Lever - ', '')                                   as Sub_Parent,
    Cur_Actual                                                              as Sub_Cur_Actual,
    BSP_Benchmark                                                           as Sub_BSP_Benchmark,
    If(Plant = Peek('Plant') AND [WC Object ID] = Peek('WC Object ID')
         AND Replace(KPI_Category, 'Lever - ', '') = Peek('Sub_Parent'),
       Peek('Sub_Rank') + 1, 1)                                             as Sub_Rank
RESIDENT InsightRecords
WHERE Period_Start = $(v2WeekStart)
  AND KPI_Category = 'Lever - Downtime %'
ORDER BY Plant, [WC Object ID], KPI_Category, Sheet_Impact DESC;


// ---- Step F3a: sub-lever position maps (7 fields × 2 sub-ranks = 14 maps) ----
// Key: Plant|WCObjectID|ParentName

Sub_R1_Name_Map:
MAPPING LOAD Plant & '|' & [WC Object ID] & '|' & Sub_Parent, Sub_Name
RESIDENT Temp_SubLeversRanked WHERE Sub_Rank = 1;

Sub_R1_Reasons_Map:
MAPPING LOAD Plant & '|' & [WC Object ID] & '|' & Sub_Parent, Sub_Reasons
RESIDENT Temp_SubLeversRanked WHERE Sub_Rank = 1;

Sub_R1_Sheets_Map:
MAPPING LOAD Plant & '|' & [WC Object ID] & '|' & Sub_Parent, Sub_Sheets
RESIDENT Temp_SubLeversRanked WHERE Sub_Rank = 1;

Sub_R1_GapPct_Map:
MAPPING LOAD Plant & '|' & [WC Object ID] & '|' & Sub_Parent, Sub_Gap_Pct
RESIDENT Temp_SubLeversRanked WHERE Sub_Rank = 1;

Sub_R1_Streak_Map:
MAPPING LOAD Plant & '|' & [WC Object ID] & '|' & Sub_Parent, Sub_Streak
RESIDENT Temp_SubLeversRanked WHERE Sub_Rank = 1;

Sub_R1_CurActual_Map:
MAPPING LOAD Plant & '|' & [WC Object ID] & '|' & Sub_Parent, Sub_Cur_Actual
RESIDENT Temp_SubLeversRanked WHERE Sub_Rank = 1;

Sub_R1_BSP_Map:
MAPPING LOAD Plant & '|' & [WC Object ID] & '|' & Sub_Parent, Sub_BSP_Benchmark
RESIDENT Temp_SubLeversRanked WHERE Sub_Rank = 1;

Sub_R2_Name_Map:
MAPPING LOAD Plant & '|' & [WC Object ID] & '|' & Sub_Parent, Sub_Name
RESIDENT Temp_SubLeversRanked WHERE Sub_Rank = 2;

Sub_R2_Reasons_Map:
MAPPING LOAD Plant & '|' & [WC Object ID] & '|' & Sub_Parent, Sub_Reasons
RESIDENT Temp_SubLeversRanked WHERE Sub_Rank = 2;

Sub_R2_Sheets_Map:
MAPPING LOAD Plant & '|' & [WC Object ID] & '|' & Sub_Parent, Sub_Sheets
RESIDENT Temp_SubLeversRanked WHERE Sub_Rank = 2;

Sub_R2_GapPct_Map:
MAPPING LOAD Plant & '|' & [WC Object ID] & '|' & Sub_Parent, Sub_Gap_Pct
RESIDENT Temp_SubLeversRanked WHERE Sub_Rank = 2;

Sub_R2_Streak_Map:
MAPPING LOAD Plant & '|' & [WC Object ID] & '|' & Sub_Parent, Sub_Streak
RESIDENT Temp_SubLeversRanked WHERE Sub_Rank = 2;

Sub_R2_CurActual_Map:
MAPPING LOAD Plant & '|' & [WC Object ID] & '|' & Sub_Parent, Sub_Cur_Actual
RESIDENT Temp_SubLeversRanked WHERE Sub_Rank = 2;

Sub_R2_BSP_Map:
MAPPING LOAD Plant & '|' & [WC Object ID] & '|' & Sub_Parent, Sub_BSP_Benchmark
RESIDENT Temp_SubLeversRanked WHERE Sub_Rank = 2;

DROP TABLE Temp_SubLeversRanked;


// ---- Step G: fallback — rank ALL levers, but only for machines ----
// that have no pool levers (ApplyMap returns 0 for those machines)

Temp_AllLeversRanked:
NoConcatenate
LOAD
    Plant,
    [WC Object ID],
    KPI_Name                                                        as Lever_Name,
    Reasons                                                         as Lever_Reasons,
    Sheet_Impact                                                    as Lever_Sheets,
    Gap_Pct                                                         as Lever_Gap_Pct,
    Streak_4wk                                                      as Lever_Streak,
    Replace(KPI_Category, 'Lever - ', '')                           as Lever_Parent_Outcome,
    Cur_Actual                                                      as Lever_Cur_Actual,
    BSP_Benchmark                                                   as Lever_BSP_Benchmark,
    If(Plant = Peek('Plant') AND [WC Object ID] = Peek('WC Object ID'),
       Peek('Lever_Rank') + 1, 1)                                   as Lever_Rank
RESIDENT InsightRecords
WHERE Period_Start = $(v2WeekStart)
  AND WildMatch(KPI_Category, 'Lever - *')
  AND ApplyMap('HasPoolLevers_Map', Plant & '|' & [WC Object ID], 0) = 0
ORDER BY Plant, [WC Object ID], Sheet_Impact DESC;

DROP MAPPING TABLE HasPoolLevers_Map;


// ---- Step H: assemble final lever list (up to 5 per machine) ----
// Pass 1  : unaffected levers (not Downtime %)
//           + swap targets with zero sub-reasons (parent kept as fallback)
// Pass 2a : first sub-reason replacing each Downtime % slot
// Pass 2b : second sub-reason when 2+ exist
// Each pass runs for both pool-lever and fallback-lever sources.
// Order_Key = ParentRank*10 + SubOffset so ORDER BY ASC preserves original
// parent ordering with sub-reasons immediately following their parent slot.

Temp_FinalLevers:
NoConcatenate
LOAD
    Plant, [WC Object ID],
    Lever_Rank * 10 + 0                                     as Order_Key,
    Lever_Name, Lever_Reasons, Lever_Sheets, Lever_Gap_Pct,
    Lever_Streak, Lever_Parent_Outcome, Lever_Cur_Actual, Lever_BSP_Benchmark
RESIDENT Temp_PoolLeversRanked
WHERE Lever_Rank <= 3
  AND (Match(Lever_Name, 'Downtime %') = 0
       OR IsNull(ApplyMap('Sub_R1_Name_Map',
            Plant & '|' & [WC Object ID] & '|' & Lever_Name, Null())));

CONCATENATE (Temp_FinalLevers)
LOAD
    Plant, [WC Object ID],
    Lever_Rank * 10 + 0                                     as Order_Key,
    Lever_Name, Lever_Reasons, Lever_Sheets, Lever_Gap_Pct,
    Lever_Streak, Lever_Parent_Outcome, Lever_Cur_Actual, Lever_BSP_Benchmark
RESIDENT Temp_AllLeversRanked
WHERE Lever_Rank <= 3
  AND (Match(Lever_Name, 'Downtime %') = 0
       OR IsNull(ApplyMap('Sub_R1_Name_Map',
            Plant & '|' & [WC Object ID] & '|' & Lever_Name, Null())));

// Pass 2a — first sub-reason (pool source)
CONCATENATE (Temp_FinalLevers)
LOAD
    Plant, [WC Object ID],
    Lever_Rank * 10 + 1                                                             as Order_Key,
    ApplyMap('Sub_R1_Name_Map',      Plant & '|' & [WC Object ID] & '|' & Lever_Name, Null())  as Lever_Name,
    ApplyMap('Sub_R1_Reasons_Map',   Plant & '|' & [WC Object ID] & '|' & Lever_Name, Null())  as Lever_Reasons,
    ApplyMap('Sub_R1_Sheets_Map',    Plant & '|' & [WC Object ID] & '|' & Lever_Name, Null())  as Lever_Sheets,
    ApplyMap('Sub_R1_GapPct_Map',    Plant & '|' & [WC Object ID] & '|' & Lever_Name, Null())  as Lever_Gap_Pct,
    ApplyMap('Sub_R1_Streak_Map',    Plant & '|' & [WC Object ID] & '|' & Lever_Name, Null())  as Lever_Streak,
    Lever_Name                                                                      as Lever_Parent_Outcome,
    ApplyMap('Sub_R1_CurActual_Map', Plant & '|' & [WC Object ID] & '|' & Lever_Name, Null())  as Lever_Cur_Actual,
    ApplyMap('Sub_R1_BSP_Map',       Plant & '|' & [WC Object ID] & '|' & Lever_Name, Null())  as Lever_BSP_Benchmark
RESIDENT Temp_PoolLeversRanked
WHERE Lever_Rank <= 3 AND Match(Lever_Name, 'Downtime %') > 0
  AND Not IsNull(ApplyMap('Sub_R1_Name_Map',
       Plant & '|' & [WC Object ID] & '|' & Lever_Name, Null()));

// Pass 2a — first sub-reason (fallback source)
CONCATENATE (Temp_FinalLevers)
LOAD
    Plant, [WC Object ID],
    Lever_Rank * 10 + 1                                                             as Order_Key,
    ApplyMap('Sub_R1_Name_Map',      Plant & '|' & [WC Object ID] & '|' & Lever_Name, Null())  as Lever_Name,
    ApplyMap('Sub_R1_Reasons_Map',   Plant & '|' & [WC Object ID] & '|' & Lever_Name, Null())  as Lever_Reasons,
    ApplyMap('Sub_R1_Sheets_Map',    Plant & '|' & [WC Object ID] & '|' & Lever_Name, Null())  as Lever_Sheets,
    ApplyMap('Sub_R1_GapPct_Map',    Plant & '|' & [WC Object ID] & '|' & Lever_Name, Null())  as Lever_Gap_Pct,
    ApplyMap('Sub_R1_Streak_Map',    Plant & '|' & [WC Object ID] & '|' & Lever_Name, Null())  as Lever_Streak,
    Lever_Name                                                                      as Lever_Parent_Outcome,
    ApplyMap('Sub_R1_CurActual_Map', Plant & '|' & [WC Object ID] & '|' & Lever_Name, Null())  as Lever_Cur_Actual,
    ApplyMap('Sub_R1_BSP_Map',       Plant & '|' & [WC Object ID] & '|' & Lever_Name, Null())  as Lever_BSP_Benchmark
RESIDENT Temp_AllLeversRanked
WHERE Lever_Rank <= 3 AND Match(Lever_Name, 'Downtime %') > 0
  AND Not IsNull(ApplyMap('Sub_R1_Name_Map',
       Plant & '|' & [WC Object ID] & '|' & Lever_Name, Null()));

// Pass 2b — second sub-reason (pool source)
CONCATENATE (Temp_FinalLevers)
LOAD
    Plant, [WC Object ID],
    Lever_Rank * 10 + 2                                                             as Order_Key,
    ApplyMap('Sub_R2_Name_Map',      Plant & '|' & [WC Object ID] & '|' & Lever_Name, Null())  as Lever_Name,
    ApplyMap('Sub_R2_Reasons_Map',   Plant & '|' & [WC Object ID] & '|' & Lever_Name, Null())  as Lever_Reasons,
    ApplyMap('Sub_R2_Sheets_Map',    Plant & '|' & [WC Object ID] & '|' & Lever_Name, Null())  as Lever_Sheets,
    ApplyMap('Sub_R2_GapPct_Map',    Plant & '|' & [WC Object ID] & '|' & Lever_Name, Null())  as Lever_Gap_Pct,
    ApplyMap('Sub_R2_Streak_Map',    Plant & '|' & [WC Object ID] & '|' & Lever_Name, Null())  as Lever_Streak,
    Lever_Name                                                                      as Lever_Parent_Outcome,
    ApplyMap('Sub_R2_CurActual_Map', Plant & '|' & [WC Object ID] & '|' & Lever_Name, Null())  as Lever_Cur_Actual,
    ApplyMap('Sub_R2_BSP_Map',       Plant & '|' & [WC Object ID] & '|' & Lever_Name, Null())  as Lever_BSP_Benchmark
RESIDENT Temp_PoolLeversRanked
WHERE Lever_Rank <= 3 AND Match(Lever_Name, 'Downtime %') > 0
  AND Not IsNull(ApplyMap('Sub_R2_Name_Map',
       Plant & '|' & [WC Object ID] & '|' & Lever_Name, Null()));

// Pass 2b — second sub-reason (fallback source)
CONCATENATE (Temp_FinalLevers)
LOAD
    Plant, [WC Object ID],
    Lever_Rank * 10 + 2                                                             as Order_Key,
    ApplyMap('Sub_R2_Name_Map',      Plant & '|' & [WC Object ID] & '|' & Lever_Name, Null())  as Lever_Name,
    ApplyMap('Sub_R2_Reasons_Map',   Plant & '|' & [WC Object ID] & '|' & Lever_Name, Null())  as Lever_Reasons,
    ApplyMap('Sub_R2_Sheets_Map',    Plant & '|' & [WC Object ID] & '|' & Lever_Name, Null())  as Lever_Sheets,
    ApplyMap('Sub_R2_GapPct_Map',    Plant & '|' & [WC Object ID] & '|' & Lever_Name, Null())  as Lever_Gap_Pct,
    ApplyMap('Sub_R2_Streak_Map',    Plant & '|' & [WC Object ID] & '|' & Lever_Name, Null())  as Lever_Streak,
    Lever_Name                                                                      as Lever_Parent_Outcome,
    ApplyMap('Sub_R2_CurActual_Map', Plant & '|' & [WC Object ID] & '|' & Lever_Name, Null())  as Lever_Cur_Actual,
    ApplyMap('Sub_R2_BSP_Map',       Plant & '|' & [WC Object ID] & '|' & Lever_Name, Null())  as Lever_BSP_Benchmark
RESIDENT Temp_AllLeversRanked
WHERE Lever_Rank <= 3 AND Match(Lever_Name, 'Downtime %') > 0
  AND Not IsNull(ApplyMap('Sub_R2_Name_Map',
       Plant & '|' & [WC Object ID] & '|' & Lever_Name, Null()));

DROP TABLE Temp_PoolLeversRanked;
DROP TABLE Temp_AllLeversRanked;

DROP MAPPING TABLE Sub_R1_Name_Map;
DROP MAPPING TABLE Sub_R1_Reasons_Map;
DROP MAPPING TABLE Sub_R1_Sheets_Map;
DROP MAPPING TABLE Sub_R1_GapPct_Map;
DROP MAPPING TABLE Sub_R1_Streak_Map;
DROP MAPPING TABLE Sub_R1_CurActual_Map;
DROP MAPPING TABLE Sub_R1_BSP_Map;
DROP MAPPING TABLE Sub_R2_Name_Map;
DROP MAPPING TABLE Sub_R2_Reasons_Map;
DROP MAPPING TABLE Sub_R2_Sheets_Map;
DROP MAPPING TABLE Sub_R2_GapPct_Map;
DROP MAPPING TABLE Sub_R2_Streak_Map;
DROP MAPPING TABLE Sub_R2_CurActual_Map;
DROP MAPPING TABLE Sub_R2_BSP_Map;


// ---- Step H2: re-rank final levers 1..N per machine ----

Temp_FinalLeversRanked:
NoConcatenate
LOAD
    Plant, [WC Object ID],
    Lever_Name, Lever_Reasons, Lever_Sheets, Lever_Gap_Pct,
    Lever_Streak, Lever_Parent_Outcome, Lever_Cur_Actual, Lever_BSP_Benchmark,
    If(Plant = Peek('Plant') AND [WC Object ID] = Peek('WC Object ID'),
       Peek('Lever_Rank') + 1, 1)  as Lever_Rank
RESIDENT Temp_FinalLevers
ORDER BY Plant, [WC Object ID], Order_Key ASC;

DROP TABLE Temp_FinalLevers;


// ---- Step I: lever position maps (8 fields × 5 ranks = 40 maps) ----

Lever1_Name_Map:
MAPPING LOAD Plant & '|' & [WC Object ID], Lever_Name
RESIDENT Temp_FinalLeversRanked WHERE Lever_Rank = 1;

Lever1_Reasons_Map:
MAPPING LOAD Plant & '|' & [WC Object ID], Lever_Reasons
RESIDENT Temp_FinalLeversRanked WHERE Lever_Rank = 1;

Lever1_Sheets_Map:
MAPPING LOAD Plant & '|' & [WC Object ID], Lever_Sheets
RESIDENT Temp_FinalLeversRanked WHERE Lever_Rank = 1;

Lever1_GapPct_Map:
MAPPING LOAD Plant & '|' & [WC Object ID], Lever_Gap_Pct
RESIDENT Temp_FinalLeversRanked WHERE Lever_Rank = 1;

Lever1_Streak_Map:
MAPPING LOAD Plant & '|' & [WC Object ID], Lever_Streak
RESIDENT Temp_FinalLeversRanked WHERE Lever_Rank = 1;

Lever1_Parent_Map:
MAPPING LOAD Plant & '|' & [WC Object ID], Lever_Parent_Outcome
RESIDENT Temp_FinalLeversRanked WHERE Lever_Rank = 1;

Lever1_CurActual_Map:
MAPPING LOAD Plant & '|' & [WC Object ID], Lever_Cur_Actual
RESIDENT Temp_FinalLeversRanked WHERE Lever_Rank = 1;

Lever1_BSP_Map:
MAPPING LOAD Plant & '|' & [WC Object ID], Lever_BSP_Benchmark
RESIDENT Temp_FinalLeversRanked WHERE Lever_Rank = 1;

Lever2_Name_Map:
MAPPING LOAD Plant & '|' & [WC Object ID], Lever_Name
RESIDENT Temp_FinalLeversRanked WHERE Lever_Rank = 2;

Lever2_Reasons_Map:
MAPPING LOAD Plant & '|' & [WC Object ID], Lever_Reasons
RESIDENT Temp_FinalLeversRanked WHERE Lever_Rank = 2;

Lever2_Sheets_Map:
MAPPING LOAD Plant & '|' & [WC Object ID], Lever_Sheets
RESIDENT Temp_FinalLeversRanked WHERE Lever_Rank = 2;

Lever2_GapPct_Map:
MAPPING LOAD Plant & '|' & [WC Object ID], Lever_Gap_Pct
RESIDENT Temp_FinalLeversRanked WHERE Lever_Rank = 2;

Lever2_Streak_Map:
MAPPING LOAD Plant & '|' & [WC Object ID], Lever_Streak
RESIDENT Temp_FinalLeversRanked WHERE Lever_Rank = 2;

Lever2_Parent_Map:
MAPPING LOAD Plant & '|' & [WC Object ID], Lever_Parent_Outcome
RESIDENT Temp_FinalLeversRanked WHERE Lever_Rank = 2;

Lever2_CurActual_Map:
MAPPING LOAD Plant & '|' & [WC Object ID], Lever_Cur_Actual
RESIDENT Temp_FinalLeversRanked WHERE Lever_Rank = 2;

Lever2_BSP_Map:
MAPPING LOAD Plant & '|' & [WC Object ID], Lever_BSP_Benchmark
RESIDENT Temp_FinalLeversRanked WHERE Lever_Rank = 2;

Lever3_Name_Map:
MAPPING LOAD Plant & '|' & [WC Object ID], Lever_Name
RESIDENT Temp_FinalLeversRanked WHERE Lever_Rank = 3;

Lever3_Reasons_Map:
MAPPING LOAD Plant & '|' & [WC Object ID], Lever_Reasons
RESIDENT Temp_FinalLeversRanked WHERE Lever_Rank = 3;

Lever3_Sheets_Map:
MAPPING LOAD Plant & '|' & [WC Object ID], Lever_Sheets
RESIDENT Temp_FinalLeversRanked WHERE Lever_Rank = 3;

Lever3_GapPct_Map:
MAPPING LOAD Plant & '|' & [WC Object ID], Lever_Gap_Pct
RESIDENT Temp_FinalLeversRanked WHERE Lever_Rank = 3;

Lever3_Streak_Map:
MAPPING LOAD Plant & '|' & [WC Object ID], Lever_Streak
RESIDENT Temp_FinalLeversRanked WHERE Lever_Rank = 3;

Lever3_Parent_Map:
MAPPING LOAD Plant & '|' & [WC Object ID], Lever_Parent_Outcome
RESIDENT Temp_FinalLeversRanked WHERE Lever_Rank = 3;

Lever3_CurActual_Map:
MAPPING LOAD Plant & '|' & [WC Object ID], Lever_Cur_Actual
RESIDENT Temp_FinalLeversRanked WHERE Lever_Rank = 3;

Lever3_BSP_Map:
MAPPING LOAD Plant & '|' & [WC Object ID], Lever_BSP_Benchmark
RESIDENT Temp_FinalLeversRanked WHERE Lever_Rank = 3;

Lever4_Name_Map:
MAPPING LOAD Plant & '|' & [WC Object ID], Lever_Name
RESIDENT Temp_FinalLeversRanked WHERE Lever_Rank = 4;

Lever4_Reasons_Map:
MAPPING LOAD Plant & '|' & [WC Object ID], Lever_Reasons
RESIDENT Temp_FinalLeversRanked WHERE Lever_Rank = 4;

Lever4_Sheets_Map:
MAPPING LOAD Plant & '|' & [WC Object ID], Lever_Sheets
RESIDENT Temp_FinalLeversRanked WHERE Lever_Rank = 4;

Lever4_GapPct_Map:
MAPPING LOAD Plant & '|' & [WC Object ID], Lever_Gap_Pct
RESIDENT Temp_FinalLeversRanked WHERE Lever_Rank = 4;

Lever4_Streak_Map:
MAPPING LOAD Plant & '|' & [WC Object ID], Lever_Streak
RESIDENT Temp_FinalLeversRanked WHERE Lever_Rank = 4;

Lever4_Parent_Map:
MAPPING LOAD Plant & '|' & [WC Object ID], Lever_Parent_Outcome
RESIDENT Temp_FinalLeversRanked WHERE Lever_Rank = 4;

Lever4_CurActual_Map:
MAPPING LOAD Plant & '|' & [WC Object ID], Lever_Cur_Actual
RESIDENT Temp_FinalLeversRanked WHERE Lever_Rank = 4;

Lever4_BSP_Map:
MAPPING LOAD Plant & '|' & [WC Object ID], Lever_BSP_Benchmark
RESIDENT Temp_FinalLeversRanked WHERE Lever_Rank = 4;

Lever5_Name_Map:
MAPPING LOAD Plant & '|' & [WC Object ID], Lever_Name
RESIDENT Temp_FinalLeversRanked WHERE Lever_Rank = 5;

Lever5_Reasons_Map:
MAPPING LOAD Plant & '|' & [WC Object ID], Lever_Reasons
RESIDENT Temp_FinalLeversRanked WHERE Lever_Rank = 5;

Lever5_Sheets_Map:
MAPPING LOAD Plant & '|' & [WC Object ID], Lever_Sheets
RESIDENT Temp_FinalLeversRanked WHERE Lever_Rank = 5;

Lever5_GapPct_Map:
MAPPING LOAD Plant & '|' & [WC Object ID], Lever_Gap_Pct
RESIDENT Temp_FinalLeversRanked WHERE Lever_Rank = 5;

Lever5_Streak_Map:
MAPPING LOAD Plant & '|' & [WC Object ID], Lever_Streak
RESIDENT Temp_FinalLeversRanked WHERE Lever_Rank = 5;

Lever5_Parent_Map:
MAPPING LOAD Plant & '|' & [WC Object ID], Lever_Parent_Outcome
RESIDENT Temp_FinalLeversRanked WHERE Lever_Rank = 5;

Lever5_CurActual_Map:
MAPPING LOAD Plant & '|' & [WC Object ID], Lever_Cur_Actual
RESIDENT Temp_FinalLeversRanked WHERE Lever_Rank = 5;

Lever5_BSP_Map:
MAPPING LOAD Plant & '|' & [WC Object ID], Lever_BSP_Benchmark
RESIDENT Temp_FinalLeversRanked WHERE Lever_Rank = 5;

DROP TABLE Temp_FinalLeversRanked;


// ---- Step J: base grain + pivot to wide via ApplyMap ----

MachineWeekSummary_Base:
NoConcatenate
LOAD DISTINCT
    Plant,
    [WC Object ID],
    [Plant - WC],
    Department,
    Period_Start
RESIDENT InsightRecords
WHERE Period_Start = $(v2WeekStart)
  AND (KPI_Category = 'Outcome' OR WildMatch(KPI_Category, 'Lever - *'));

MachineWeekSummary:
NoConcatenate
LOAD
    Plant,
    [WC Object ID],
    [Plant - WC],
    Department,
