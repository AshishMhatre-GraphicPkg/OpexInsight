<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<style>
  body { font-family: Calibri, Arial, sans-serif; font-size: 14px; color: #1a1a1a; }
  h2 { color: #003366; border-bottom: 2px solid #003366; padding-bottom: 4px; }
  h3 { color: #005099; margin-top: 24px; margin-bottom: 4px; }
  .impact { font-size: 1.05em; }
  .levers { margin-top: 8px; padding-left: 18px; }
  .levers li { margin-bottom: 4px; }
  .streak { color: #c0392b; font-weight: bold; }
  .findings { margin-top: 14px; background: #f9f9f9; border-left: 3px solid #c0392b; padding: 8px 12px; border-radius: 2px; }
  .findings h4 { margin: 0 0 6px; color: #7b0000; font-size: 0.95em; }
  .findings p { margin: 4px 0; }
  .findings-sections { margin: 6px 0 4px; padding-left: 16px; }
  .findings-sections li { margin-bottom: 3px; font-size: 0.93em; }
  .findings-sections li.corroborated { font-weight: bold; color: #7b0000; }
  .findings-note { font-size: 0.85em; color: #666; margin-top: 6px; }
  .pm-table { margin-top: 14px; border-collapse: collapse; width: 100%; max-width: 480px; font-size: 0.93em; }
  .pm-table th { background: #fff3cd; color: #664d00; text-align: left; padding: 5px 8px; }
  .pm-table td { padding: 4px 8px; border-bottom: 1px solid #eee; }
  .pm-count { text-align: right; }
  .pm-total-row td { border-top: 2px solid #ccc; }
  .maint-table { margin-top: 14px; margin-bottom: 24px; border-collapse: collapse; width: 100%; max-width: 600px; font-size: 0.93em; }
  .maint-table th { background: #fff3cd; color: #664d00; text-align: left; padding: 5px 8px; }
  .maint-table td { padding: 4px 8px; border-bottom: 1px solid #eee; }
  .maint-count { text-align: right; }
  .maint-total-row td { border-top: 2px solid #ccc; font-weight: bold; }
  .footer { margin-top: 32px; font-size: 12px; color: #888; border-top: 1px solid #ddd; padding-top: 8px; }
  .overview-tiles { border-collapse: separate; border-spacing: 12px 0; margin: 12px 0 16px; }
  .tile { background: #f0f4fa; border-radius: 6px; padding: 10px 20px; text-align: center; min-width: 120px; }
  .tile-value { font-size: 1.4em; font-weight: bold; color: #003366; }
  .tile-label { font-size: 0.8em; color: #555; margin-top: 2px; }
  .movers-table { border-collapse: collapse; width: 100%; max-width: 640px; font-size: 0.93em; margin-bottom: 12px; }
  .movers-table th { background: #e8eef6; color: #003366; text-align: left; padding: 5px 8px; }
  .movers-table td { padding: 4px 8px; border-bottom: 1px solid #eee; }
  .movers-count { text-align: center; }
  .maint-line { font-size: 0.9em; color: #664d00; background: #fffbf0; border-left: 3px solid #f0ad00; padding: 6px 10px; margin-top: 8px; }
</style>
</head>
<body>

<h2>{{ subject }}</h2>

{% if digest.overview %}
{% set ov = digest.overview %}
<table class="overview-tiles">
  <tr>
    <td class="tile">
      <div class="tile-value">{{ ov.total_sheets | comma_int }}</div>
      <div class="tile-label">Sheets lost vs BSP</div>
    </td>
    <td class="tile">
      <div class="tile-value">{{ ov.machines_impacted }}</div>
      <div class="tile-label">Machines impacted</div>
    </td>
    {% if ov.top_driver_name %}
    <td class="tile">
      <div class="tile-value">{{ ov.top_driver_name }}</div>
      <div class="tile-label">Top driver ({{ ov.top_driver_sheets | comma_int }} sheets)</div>
    </td>
    {% endif %}
  </tr>
</table>

{% if ov.top_movers %}
<table class="movers-table">
  <thead>
    <tr>
      <th>Machine</th>
      <th class="movers-count">Cur OEE</th>
      <th class="movers-count">BSP OEE</th>
      <th class="movers-count">Sheets Lost vs BSP OEE ▼</th>
      <th>Top Lever</th>
    </tr>
  </thead>
  <tbody>
    {% for row in ov.top_movers %}
    <tr>
      <td>{{ row.plant_wc }}</td>
      <td class="movers-count">{{ row.cur_oee | percent if row.cur_oee is not none else '&mdash;' }}</td>
      <td class="movers-count">{{ row.bsp_oee | percent if row.bsp_oee is not none else '&mdash;' }}</td>
      <td class="movers-count">{{ row.total_sheet_impact | comma_int }}</td>
      <td>{{ row.top_lever if row.top_lever else '&mdash;' }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
{% endif %}

{% if ov.has_maintenance %}
<p class="maint-line">
  Maintenance: <strong>{{ ov.maint_open }}</strong> open {{ ov.maint_open | pluralize('finding') }}
  {%- if ov.maint_priority10 %} (<strong>{{ ov.maint_priority10 }}</strong> priority-10){%- endif %},
  <strong>{{ ov.maint_overdue_pm }}</strong> {{ ov.maint_overdue_pm | pluralize('PM') }} overdue &mdash; see Maintenance Report below.
</p>
{% endif %}
{% endif %}

{% set maint_machines = digest.machines | selectattr('findings') | list %}
{% set pm_machines = digest.machines | selectattr('pm_summary') | list %}
{% set all_maint_machines = (maint_machines + pm_machines) | unique(attribute='plant_wc') | list %}
{% if all_maint_machines %}
<h3 style="color:#664d00; border-bottom: 2px solid #fff3cd;">Maintenance Report</h3>
<table class="maint-table">
  <thead>
    <tr>
      <th>Machine</th>
      <th class="maint-count">GC Open</th>
      <th class="maint-count">GC Missing WO</th>
      <th class="maint-count">Overdue PM Procedures</th>
    </tr>
  </thead>
  <tbody>
    {% for m in all_maint_machines %}
    <tr>
      <td>{{ m.plant_wc }}</td>
      <td class="maint-count">{{ m.findings.total_open if m.findings else '' }}</td>
      <td class="maint-count">{{ m.findings.total_missing_wo if m.findings else '' }}</td>
      <td class="maint-count">{{ m.pm_summary.total_overdue if m.pm_summary else '' }}</td>
    </tr>
    {% endfor %}
    <tr class="maint-total-row">
      <td>Total</td>
      <td class="maint-count">{{ all_maint_machines | selectattr('findings') | map(attribute='findings.total_open') | sum }}</td>
      <td class="maint-count">{{ all_maint_machines | selectattr('findings') | map(attribute='findings.total_missing_wo') | sum }}</td>
      <td class="maint-count">{{ all_maint_machines | selectattr('pm_summary') | map(attribute='pm_summary.total_overdue') | sum }}</td>
    </tr>
  </tbody>
</table>
{% endif %}

{% for m in digest.machines %}
<h3>{{ m.plant_wc }} — {{ m.department }}</h3>
<p class="impact">
  <strong>{{ m.plant_wc }}</strong> lost
  <strong>{{ m.total_sheet_impact | comma_int }} sheets</strong> of OEE Impact this week.
</p>

{% if m.levers %}
<p>To close those gaps, focus on these top levers:</p>
<ul class="levers">
{% for l in m.levers %}
  <li>
    <strong>{{ l.name }}{% if l.reasons %} — {{ l.reasons }}{% endif %}</strong>
    ({{ l.parent_outcome }},
     {{ l.sheets | comma_int }} sheets lost,
     {%- if l.cur_actual %} actual {{ l.cur_actual }} vs BSP {{ l.bsp_benchmark }},{% endif %}
     gap {{ "%.1f" | format(l.gap_pct) }}%
     {%- if l.streak > 0 %},
     <span class="streak">{{ l.streak }}/4 weeks {{ l.streak_direction }}</span>{% endif %})
  </li>
{% endfor %}
</ul>
<p>
  Improving these gaps will move <strong>OEE</strong>.
</p>
{% endif %}

{% if m.findings %}
<div class="findings">
  <h4>Graphic Care Findings</h4>
  <p>
    Open: <strong>{{ m.findings.total_open }}</strong> &middot;
    Missing WO: <strong>{{ m.findings.total_missing_wo }}</strong> &middot;
    Overdue {{ m.findings.total_overdue | pluralize('WO') }}: <strong>{{ m.findings.total_overdue }}</strong>
    {%- if m.findings.high_priority_count %}
      &middot; <span style="color:#7b0000;">&#9888; Priority-10: <strong>{{ m.findings.high_priority_count }}</strong></span>
    {%- endif %}
  </p>
  <ul class="findings-sections">
  {% for s in m.findings.by_section %}
    <li{% if s.is_corroborated %} class="corroborated"{% endif %}>
      {{ s.section }} &mdash; {{ s.open_count }} Open
      {%- if s.missing_wo_count %}, {{ s.missing_wo_count }} Missing WO{% endif %}
      {%- if s.overdue_count %}, {{ s.overdue_count }} Overdue{% endif %}
      {%- if s.is_corroborated %} &larr; linked to active lever{% endif %}
    </li>
  {% endfor %}
  </ul>
  {% if m.findings.corroborated_sections %}
  <p class="findings-note">
    Sections marked &larr; are linked to this machine&#39;s active OEE levers.
    Unresolved findings may be contributing to the gaps shown above.
  </p>
  {% endif %}
</div>
{% endif %}

{% if m.pm_summary %}
<table class="pm-table">
  <thead>
    <tr><th colspan="2">Critically Overdue Preventive Maintenance</th></tr>
    <tr><th>Core PM</th><th class="pm-count">Overdue Count</th></tr>
  </thead>
  <tbody>
    {% for row in m.pm_summary.by_core_pm %}
    <tr>
      <td>{{ row.core_pm }}</td>
      <td class="pm-count">{{ row.overdue_count }}</td>
    </tr>
    {% endfor %}
    <tr class="pm-total-row">
      <td><strong>Total</strong></td>
      <td class="pm-count"><strong>{{ m.pm_summary.total_overdue }}</strong></td>
    </tr>
  </tbody>
</table>
{% endif %}

{% endfor %}

<div class="footer">
  Generated automatically by the Folding Carton Actionable Intelligence Platform.
  Do not reply to this email.
</div>
</body>
</html>
