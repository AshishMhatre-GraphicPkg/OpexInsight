{# Manager digest V2 — reduced-density redesign.
   V1 (KPI tiles + movers table + per-machine lever/findings/PM detail) is
   archived at templates/archive/manager_v1.html.j2 for reference/rollback.

   V2 shows only the top FOCUS_MACHINE_COUNT (grouper.py) machines by
   Total_Sheet_Impact as Who/Why/How-to-Fix cards, rolls the rest into a
   one-line "also impacted" list, and replaces the per-machine maintenance
   detail with a single plant-wide summary line. No calculation, threshold,
   ranking, or selection logic changes here — grouper.py still does all of
   that; this template only decides how much of it to show. #}
{% import '_theme.j2' as t %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<style>
  /* Progressive enhancement only — nothing here is load-bearing.
     Outlook desktop (Word engine) ignores most of this block and,
     in Outlook.com, drops <style> entirely. Every element below also
     carries an inline style= attribute with the same values so the
     email still reads correctly with this block stripped. */
  body { font-family: {{ t.font_stack }}; font-size: 14px; color: {{ t.ink }}; margin: 0; padding: 0; background-color: {{ t.surface }}; }
  .content-wrap { max-width: 640px; margin: 0 auto; background-color: {{ t.white }}; }
  .kpi-tiles { border-collapse: separate; border-spacing: 6px 0; margin: 16px 0; width: 100%; }
  .focus-card { margin-top: 16px; background-color: {{ t.surface }}; border-left: 4px solid {{ t.accent }}; }
  .focus-table { border-collapse: collapse; width: 100%; }
  .focus-table td { vertical-align: top; padding: 14px 12px; }
  .dept-pill { display: inline-block; font-size: 0.72em; color: {{ t.primary }}; background: {{ t.surface_alt }}; padding: 2px 8px; border-radius: 10px; margin-top: 6px; }
  .card-label { font-size: 0.7em; font-weight: 700; color: {{ t.primary }}; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 6px; }
  .streak-note { color: {{ t.attn_text }}; font-weight: bold; }
  .gc-note { margin-top: 8px; padding: 6px 8px; background: {{ t.attn_bg }}; border-left: 3px solid {{ t.attn_rule }}; font-size: 0.86em; color: {{ t.attn_text }}; }
  .also-impacted { margin-top: 14px; font-size: 0.9em; color: {{ t.ink_muted }}; }
  .maint-summary { margin-top: 10px; padding: 10px 14px; background: {{ t.surface }}; border-left: 3px solid {{ t.accent }}; font-size: 0.93em; }
  .maint-explain { font-size: 0.82em; color: {{ t.ink_muted }}; margin-top: 6px; }
  @media (max-width: 620px) {
    .kpi-tiles, .kpi-tiles tbody, .kpi-tiles tr, .kpi-tiles td { display: block; width: 100% !important; }
    .focus-table, .focus-table tbody, .focus-table tr, .focus-table td { display: block; width: 100% !important; }
  }
</style>
</head>
<body style="font-family:{{ t.font_stack }}; font-size:14px; color:{{ t.ink }}; margin:0; padding:0; background-color:{{ t.surface }};">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:{{ t.surface }};">
<tr><td align="center">
<table role="presentation" width="640" cellpadding="0" cellspacing="0" border="0" class="content-wrap" style="max-width:640px; width:100%; background-color:{{ t.white }};">
<tr>
  <td>
    {{ t.header_band(subject) }}
  </td>
</tr>
<tr>
  <td style="padding:20px 24px 24px;">

{% if digest.overview %}
{% set ov = digest.overview %}
<table class="kpi-tiles" style="border-collapse:separate; border-spacing:6px 0; margin:16px 0; width:100%;">
  <tr>
    {{ t.kpi_tile(ov.total_sheets | comma_int, "Sheets lost vs BSP") }}
    {% if ov.top_driver_name %}
    {{ t.kpi_tile(ov.top_driver_name ~ " (" ~ (ov.top_driver_sheets | comma_int) ~ ")", "Top driver") }}
    {% endif %}
  </tr>
</table>
{% endif %}

{% if digest.focus_machines %}
<div style="font-family:{{ t.font_stack }}; font-size:15px; font-weight:700; color:{{ t.primary }}; margin-top:20px; border-bottom:2px solid {{ t.surface_alt }}; padding-bottom:4px;">Where to focus this week</div>

{% for m in digest.focus_machines %}
{% set l = m.levers[0] if m.levers else none %}
<div class="focus-card" style="margin-top:16px; background-color:{{ t.surface }}; border-left:4px solid {{ t.accent }};">
<table class="focus-table" role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse; width:100%;">
  <tr>
    <td width="150" style="vertical-align:top; padding:14px 12px; width:150px;">
      <div class="card-label" style="font-size:0.7em; font-weight:700; color:{{ t.primary }}; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:6px;">Machine</div>
      <div style="font-weight:700; color:{{ t.ink }};">{{ m.plant_wc }}</div>
      <span class="dept-pill" style="display:inline-block; font-size:0.72em; color:{{ t.primary }}; background:{{ t.surface_alt }}; padding:2px 8px; border-radius:10px; margin-top:6px;">{{ m.department }}</span>
    </td>
    <td width="200" style="vertical-align:top; padding:14px 12px; width:200px;">
      <div class="card-label" style="font-size:0.7em; font-weight:700; color:{{ t.primary }}; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:6px;">Why</div>
      {% if l %}
      <div style="font-weight:700; color:{{ t.ink }};">{{ l.reasons if l.reasons else l.name }}</div>
      {% if m.outcome_1_cur_actual is not none and m.outcome_1_bsp_benchmark is not none %}
      <div style="margin-top:4px;">OEE {{ m.outcome_1_cur_actual | percent }} vs BSP {{ m.outcome_1_bsp_benchmark | percent }}</div>
      {% endif %}
      <div style="margin-top:2px; font-variant-numeric:tabular-nums;">{{ m.total_sheet_impact | comma_int }} sheets lost</div>
      <div class="streak-note" style="margin-top:4px; color:{{ t.attn_text }}; font-weight:bold;">{{ l.streak_phrase }}</div>
      {% else %}
      <div>{{ m.total_sheet_impact | comma_int }} sheets lost vs BSP this week.</div>
      {% endif %}
    </td>
    <td width="234" style="vertical-align:top; padding:14px 12px; width:234px;">
      <div class="card-label" style="font-size:0.7em; font-weight:700; color:{{ t.primary }}; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:6px;">How to fix</div>
      {% if l %}
      <div>{{ l.action }}</div>
      {% if m.findings and m.findings.corroborated_sections %}
      <div class="gc-note" style="margin-top:8px; padding:6px 8px; background:{{ t.attn_bg }}; border-left:3px solid {{ t.attn_rule }}; font-size:0.86em; color:{{ t.attn_text }};">
        &#9888; Open Graphic Care {{ m.findings.total_open | pluralize('finding') }} on {{ m.findings.corroborated_sections | join(', ') }} may already cover this — check before scheduling new work.
      </div>
      {% endif %}
      {% else %}
      <div>No single dominant lever this week — review the machine's full performance in Qlik.</div>
      {% endif %}
    </td>
  </tr>
</table>
</div>
{% endfor %}
{% endif %}

{% if digest.other_machines %}
<div class="also-impacted" style="margin-top:14px; font-size:0.9em; color:{{ t.ink_muted }};">
  Also impacted:
  {%- for m in digest.other_machines %} {{ m.plant_wc }} ({{ m.total_sheet_impact | comma_int }} sheets){% if not loop.last %},{% endif %}{% endfor %}
</div>
{% endif %}

{% if digest.overview and digest.overview.has_maintenance %}
{% set ov = digest.overview %}
<div style="font-family:{{ t.font_stack }}; font-size:15px; font-weight:700; color:{{ t.primary }}; margin-top:22px; border-bottom:2px solid {{ t.surface_alt }}; padding-bottom:4px;">Maintenance report</div>
<div class="maint-summary" style="margin-top:10px; padding:10px 14px; background:{{ t.surface }}; border-left:3px solid {{ t.accent }}; font-size:0.93em;">
  <strong>{{ ov.maint_open }}</strong> open Graphic Care {{ ov.maint_open | pluralize('Finding') }}
  {%- if ov.maint_priority10 %} (<strong>{{ ov.maint_priority10 }}</strong> priority-10){% endif -%},
  <strong>{{ ov.maint_missing_wo }}</strong> Missing Work {{ ov.maint_missing_wo | pluralize('Order') }},
  <strong>{{ ov.maint_overdue_pm }}</strong> critically overdue PM {{ ov.maint_overdue_pm | pluralize('procedure') }}.
  <div class="maint-explain" style="font-size:0.82em; color:{{ t.ink_muted }}; margin-top:6px;">
    "Critically overdue" means a PM procedure that is significantly overdue and has exceeded its allowable completion window — these are prioritised ahead of routine maintenance.
  </div>
</div>
{% endif %}

  </td>
</tr>
<tr>
  <td>
    {{ t.footer("Generated automatically by the Folding Carton Actionable Intelligence Platform. Do not reply to this email.") }}
  </td>
</tr>
</table>
</td></tr>
</table>
</body>
</html>
